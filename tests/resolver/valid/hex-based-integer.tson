!!id:"https://tson.io/test-suite/resolver/valid/hex-based-integer.tson"
{
  spec: "§4.3"
  description: "An unquoted 0x-prefixed token identifies as a based-integer number in hex"
  outcome: valid
  base-value: {
    kind: number
