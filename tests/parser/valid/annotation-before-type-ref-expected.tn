          }
        }
      ]
      type-ref: "gold"
      core: {
        kind: record
        fields: [
          {
            name: "id"
            value: {
              schema-ref: _
              value: {
                annotations: []
                type-ref: _
                core: {
                  kind: token
                  form: unquoted
                  text: "7"
                }
              }
            }
          }
        ]
      }
    }
  }
