!!id:"https://tson.io/test-suite/lexer/invalid/utf8-malformed-inside-quoted-token-expected.tn"
{
  spec: "§9.1"
  description: "A malformed byte inside a quoted token. This is the case a replacing decoder gets most wrong: outside a quoted token the substituted U+FFFD is an unrecognised character and an error, but here it is content, so the document reads and carries a character nobody wrote"
  encoding: "invalid-utf8"
  outcome: error
  category: lexer
}
