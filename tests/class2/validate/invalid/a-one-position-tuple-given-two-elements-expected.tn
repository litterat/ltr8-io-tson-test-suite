!!id:"https://tson.io/test-suite/class2/validate/invalid/a-one-position-tuple-given-two-elements-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.3"
  description: "A one-position tuple of `text` given two elements. The second has no position to occupy, which is what separates the tuple from the array `[text]`, where it would be one more element."
  error: { category: validation  path: "/only" }
}
