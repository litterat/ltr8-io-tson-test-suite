!!id:"https://tson.io/test-suite/class2/validate/invalid/a-duration-equal-to-its-exclusive-min-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §5.7"
  description: "`span` is `open_duration`, whose `exclusive_min` is `PT1M`. A value must be strictly greater than an exclusive minimum, so `PT1M` itself is refused."
  error: {
    category: validation
    path: "/span"
  }
}
