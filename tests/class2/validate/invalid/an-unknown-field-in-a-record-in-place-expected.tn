!!id:"https://tson.io/test-suite/class2/validate/invalid/an-unknown-field-in-a-record-in-place-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §7.2 (inline types, proposed for Revision 40)"
  description: """
    A record in place is closed under its type like any record: `colour` is no field of the record `page<order>`
    closes to, so it is a validation error at the field.
    """
  error: {
    category: validation
    path: "/p/colour"
  }
}
