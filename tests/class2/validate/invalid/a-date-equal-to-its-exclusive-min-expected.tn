!!id:"https://tson.io/test-suite/class2/validate/invalid/a-date-equal-to-its-exclusive-min-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §5.7"
  description: "`day` is `open_date`, whose `exclusive_min` is `2000-01-01`. A value must be strictly greater than an exclusive minimum, so `2000-01-01` itself is refused."
  error: {
    category: validation
    path: "/day"
  }
}
