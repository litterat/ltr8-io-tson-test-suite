!!id:"https://tson.io/test-suite/class2/validate/invalid/a-duration-equal-to-its-exclusive-max-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §5.7"
  description: "`span` is `open_duration`, whose `exclusive_max` is `PT1H`. A value must be strictly less than an exclusive maximum, so `PT1H` itself is refused."
  error: {
    category: validation
    path: "/span"
  }
}
