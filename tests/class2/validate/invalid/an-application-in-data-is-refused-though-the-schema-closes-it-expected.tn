!!id:"https://tson.io/test-suite/class2/validate/invalid/an-application-in-data-is-refused-though-the-schema-closes-it-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-DATA] §7.2.5"
  description: """
    In a data document a reference is a name, and an argument list is no data grammar: the schema declares
    `names => set<text>`, and `t: set<text>` still does not parse. The data names the declared entry, `names`.
    """
  error: {
    category: parser
  }
}
