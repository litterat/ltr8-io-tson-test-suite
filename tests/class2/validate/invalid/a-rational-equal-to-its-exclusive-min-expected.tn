!!id:"https://tson.io/test-suite/class2/validate/invalid/a-rational-equal-to-its-exclusive-min-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §5.7"
  description: "`ratio` is `open_rational`, whose `exclusive_min` is `1/3`. A value must be strictly greater than an exclusive minimum, so `1/3` itself is refused."
  error: {
    category: validation
    path: "/ratio"
  }
}
