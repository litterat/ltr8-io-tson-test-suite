!!id:"https://tson.io/test-suite/class2/validate/invalid/a-float64-equal-to-its-exclusive-max-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §5.7"
  description: "`measure` is `open_float64`, whose `exclusive_max` is `2.5`. A value must be strictly less than an exclusive maximum, so `2.5` itself is refused."
  error: {
    category: validation
    path: "/measure"
  }
}
