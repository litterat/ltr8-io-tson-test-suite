!!id:"https://tson.io/test-suite/class2/validate/invalid/a-rational-equal-to-its-exclusive-max-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §5.7"
  description: "`ratio` is `open_rational`, whose `exclusive_max` is `2/3`. A value must be strictly less than an exclusive maximum, so `2/3` itself is refused."
  error: {
    category: validation
    path: "/ratio"
  }
}
