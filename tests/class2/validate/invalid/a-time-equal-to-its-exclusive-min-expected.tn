!!id:"https://tson.io/test-suite/class2/validate/invalid/a-time-equal-to-its-exclusive-min-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §5.7"
  description: "`clock` is `open_time`, whose `exclusive_min` is `09:00:00Z`. A value must be strictly greater than an exclusive minimum, so `09:00:00Z` itself is refused."
  error: {
    category: validation
    path: "/clock"
  }
}
