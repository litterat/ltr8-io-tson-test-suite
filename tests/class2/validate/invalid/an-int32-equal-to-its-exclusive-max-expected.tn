!!id:"https://tson.io/test-suite/class2/validate/invalid/an-int32-equal-to-its-exclusive-max-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §5.7"
  description: "`count` is `open_int32`, whose `exclusive_max` is `10`. A value must be strictly less than an exclusive maximum, so `10` itself is refused."
  error: {
    category: validation
    path: "/count"
  }
}
