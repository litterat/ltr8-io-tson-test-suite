!!id:"https://tson.io/test-suite/class2/validate/invalid/a-relaxed-record-does-not-relax-a-record-it-holds-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §7.2"
  description: "A record's name_type governs its own names only: holder's admits @id, but inner is a plain, which states none and so has identifiers for names, and @a is no identifier, so it is an unrecognised field of plain."
  error: {
    category: validation
    path: "/inner/@a"
  }
}
