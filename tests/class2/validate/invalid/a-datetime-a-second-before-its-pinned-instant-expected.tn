!!id:"https://tson.io/test-suite/class2/validate/invalid/a-datetime-a-second-before-its-pinned-instant-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §5.7"
  description: "`instant` is `new_year`, pinned at `2026-01-01T00:00:00Z`. `2025-12-31T18:59:59-05:00` is `2025-12-31T23:59:59Z`, a second before the `min`, so it is refused."
  error: {
    category: validation
    path: "/instant"
  }
}
