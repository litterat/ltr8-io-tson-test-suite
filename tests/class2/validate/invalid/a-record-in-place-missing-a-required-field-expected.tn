!!id:"https://tson.io/test-suite/class2/validate/invalid/a-record-in-place-missing-a-required-field-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §7.2 (inline types, proposed for Revision 40)"
  description: """
    A record in place keeps its open record's required fields: `items` is unmarked, so a value at `p` without it is a
    validation error at the missing field.
    """
  error: {
    category: validation
    path: "/p/items"
  }
}
