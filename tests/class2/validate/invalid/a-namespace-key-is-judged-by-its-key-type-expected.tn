!!id:"https://tson.io/test-suite/class2/validate/invalid/a-namespace-key-is-judged-by-its-key-type-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-DATA] §7.7"
  description: "A namespace's keys are judged by its `key_type`, as a map's are. `1st` is no `header_name`: an identifier never begins with a digit, so the key is a token the type cannot read -- a resolver error ([TSON-DATA] §8.1)."
  schema: "fixtures/validate-namespace.tn"
  error: {
    category: resolver
    path: "/headers/1st"
  }
}
