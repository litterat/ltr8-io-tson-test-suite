{
  spec: "[TSON-SCHEMA] §5.5"
  description: "The Kelvin sign U+212A folds to `k` under NFKC_CASEFOLD but is not an ASCII letter, so ASCII_CASEFOLD leaves it and the profile refuses it."
  error: { category: resolver  path: "/fields/\u{212A}eep-Alive" }
}
