!!id:"https://tson.io/test-suite/class2/validate/invalid/a-time-a-second-past-its-pinned-value-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §5.7"
  description: "`clock` is `noon`, pinned at `12:00:00Z`. `07:00:01-05:00` is `12:00:01Z`, a second after the `max`, so it is refused."
  error: {
    category: validation
    path: "/clock"
  }
}
