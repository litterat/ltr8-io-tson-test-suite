!!id:"https://tson.io/test-suite/class2/validate/invalid/two-casings-of-one-name-are-one-key-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-DATA] §2.6, [TSON-SCHEMA] §5.5"
  description: "Under a schema a key's identity is its type's value, and both spellings fold to `content-type`, so the map holds one key twice -- reported at the second, as every duplicate-key vector at the reader layer is."
  error: {
    category: resolver
    path: "/headers/content-type"
  }
}
