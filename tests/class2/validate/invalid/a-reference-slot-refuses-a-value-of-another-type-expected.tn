!!id:"https://tson.io/test-suite/class2/validate/invalid/a-reference-slot-refuses-a-value-of-another-type-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §5.12"
  description: """
    `c1` is an entry whose value is of `customer`, which is not `order` and does not IS-A it, so a slot naming values
    of `order` refuses it.
    """
  error: {
    category: validation
    path: "/which"
  }
}
