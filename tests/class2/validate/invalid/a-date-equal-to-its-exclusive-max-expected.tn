!!id:"https://tson.io/test-suite/class2/validate/invalid/a-date-equal-to-its-exclusive-max-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §5.7"
  description: "`day` is `open_date`, whose `exclusive_max` is `2000-12-31`. A value must be strictly less than an exclusive maximum, so `2000-12-31` itself is refused."
  error: {
    category: validation
    path: "/day"
  }
}
