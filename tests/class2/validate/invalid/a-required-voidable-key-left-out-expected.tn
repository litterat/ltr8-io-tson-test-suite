{
  spec: "[TSON-SCHEMA] §5.2"
  description: "A voidable field whose name has no `?` must still be written: admitting `_` says nothing about omitting the key, so leaving `from` out is the missing-field error even though `from: _` would conform."
  schema: "fixtures/validate-field-marks.tn"
  error: {
    category: validation
    path: "/from"
  }
}
