{
  spec: "[TSON-SCHEMA] §7.2"
  description: "'a b' is no json_name, so it can be none of node's fields, which are all json_names: a record is closed under its type, and a name outside its name type is unrecognised there as an undeclared one is -- a validation error at the field's own pointer, never a name-policy refusal, since no name rule reaches what is no name."
  schema: "fixtures/validate-field-name-type.tn"
  error: {
    category: validation
    path: "/a b"
  }
}
