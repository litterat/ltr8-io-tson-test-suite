!!id:"https://tson.io/test-suite/class2/validate/invalid/a-sibling-reference-is-no-value-of-an-element-type-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2, [TSON-SCHEMA] §8.1"
  description: """
    `array.element_type` is typed `meta.type_ref`, which sets `allow_sibling: false`: read as data against the
    kernel, `kind!` is refused at the slot, as the same body in a schema is. The reference atom reads a sibling
    reference wherever a reference stands, and the facet decides which slots admit one.
    """
  error: {
    category: validation
    path: "/element_type"
  }
}
