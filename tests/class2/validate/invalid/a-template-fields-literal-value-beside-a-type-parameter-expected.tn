!!id:"https://tson.io/test-suite/class2/validate/invalid/a-template-fields-literal-value-beside-a-type-parameter-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2, [TSON-SCHEMA] §5.10, [TSON-SCHEMA] §8.1"
  description: """
    A literal needs a closed type. `value` is typed `type!`, and beside `type_param` its sibling `type` is absent, so the
    literal has no type to be read against: it is refused.
    """
  error: {
    category: validation
    path: "/field/value"
  }
}
