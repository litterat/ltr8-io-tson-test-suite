!!id:"https://tson.io/test-suite/class2/validate/invalid/an-imported-name-reaching-another-type-is-not-admitted-at-the-boundary-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §7.9"
  description: """
    `memo` is a name of the enclosing scope, imported, but it reaches an entry that is neither `rec` nor a subtype
    of it.
    """
  error: {
    category: validation
    path: "/r"
  }
}
