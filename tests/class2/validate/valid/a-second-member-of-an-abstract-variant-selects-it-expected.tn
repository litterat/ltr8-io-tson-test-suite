!!id:"https://tson.io/test-suite/class2/validate/valid/a-second-member-of-an-abstract-variant-selects-it-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.4, [TSON-SCHEMA] §7.2"
  description: """
    An abstract variant admits its family, as a field typed by it does: `!square`, another member of `shape`,
    selects `shape` at `( text | shape )` as `!circle` does, and validates as a `square`.
    """
  valid: _
}
