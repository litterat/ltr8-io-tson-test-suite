!!id:"https://tson.io/test-suite/class2/validate/valid/a-datetime-at-its-pinned-instant-in-a-third-offset-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §5.7"
  description: "`instant` is `new_year`, pinned at `2026-01-01T00:00:00Z` by a `min` written in `+01:00` and a `max` written in `Z`. `2025-12-31T19:00:00-05:00` is that instant in a third offset, so it is admitted."
  valid: _
}
