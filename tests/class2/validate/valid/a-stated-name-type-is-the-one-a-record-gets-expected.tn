!!id:"https://tson.io/test-suite/class2/validate/valid/a-stated-name-type-is-the-one-a-record-gets-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2"
  description: "A name type a record states is the one its names are read under: this schema declares its own family, `at_name`, admitting a leading '@', and `stated` names it. A record stating no name type has the kernel's `field_name`, which every schema importing core reaches and none may redeclare."
  valid: _
}
