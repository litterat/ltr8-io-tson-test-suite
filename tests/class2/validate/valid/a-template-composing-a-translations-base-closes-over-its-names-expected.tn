!!id:"https://tson.io/test-suite/class2/validate/valid/a-template-composing-a-translations-base-closes-over-its-names-expected.tn"
!!import:"https://tson.io/test-suite/schemas/validate-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10"
  description: "`page` composes `json_record` and declares '@id', a json_name and no identifier. An open record is read at its declaration as any record is, its field names judged by the name type it takes from its base, so '@id' is a name of it, and `page<text>` is the record its hand-written spelling would be."
  valid: _
}
