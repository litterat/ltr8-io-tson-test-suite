!!id:"https://tson.io/test-suite/class2/link/valid/a-qualified-name-selects-a-key-of-a-namespace-entry-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §5.6, [TSON-SCHEMA] §8.3 (values by name, proposed as §5.12)"
  description: """
    A qualified name whose first segment is an entry built with a namespace type: `myapi` resolves through the
    import to a value of `api`, and `place_order` selects a key of that map, whose value type, `method`, is the
    type the slot `ref<method>` wants.
    """
  valid: {
    binds: [more_routes myapi]
  }
}
