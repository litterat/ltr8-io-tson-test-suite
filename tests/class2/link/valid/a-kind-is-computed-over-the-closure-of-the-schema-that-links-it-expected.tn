!!id:"https://tson.io/test-suite/class2/link/valid/a-kind-is-computed-over-the-closure-of-the-schema-that-links-it-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §2.2.3"
  description: """
    A kind's members are computed over the closure of the schema being linked, an imported kind's included.
    The kernel's `meta.identifier_ref` reaches this schema through its import of meta.tn, and here it lists
    `text_identifier`, which the kernel has never seen, beside the kernel's own identifier families: so the
    pin `name_type?: = text_identifier` is a member.
    """
  valid: {
    binds: [text_enum meta.identifier_ref]
    members: [
      { name: meta.identifier_ref
        members: [meta.field_name meta.identifier meta.param_name net.scheme_name meta.type_name text_identifier] }
    ]
  }
}
