!!id:"https://tson.io/test-suite/class2/link/valid/a-schema-reaches-the-kernel-by-two-routes-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §2.2.3"
  description: """
    Imports are transitive and diamonds resolve by identity: this schema imports the meta-kernel, and imports
    link-money.tn, an ordinary library, for `money`; link-money.tn imports meta.tn, which imports the
    kernel. The kernel is one import reached by two routes, not a collision, and the closure binds
    `money`.
    """
  valid: {
    binds: [priced money]
  }
}
