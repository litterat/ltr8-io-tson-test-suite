!!id:"https://tson.io/test-suite/class2/link/valid/a-namespace-entry-reads-as-the-map-its-type-describes-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §5.6"
  description: """
    An entry holding a value of a namespace type: `api` is an instance of `namespace`, so `!api { ... }` is a value
    of it, and its payload is read as the map `api` describes, each key an identifier and each value a `method` -- an untagged value read as
    the value type, a tagged one as the type its tag names. The entry is a value of `api`, not a type.
    """
  valid: {
    binds: [admin myapi routes]
  }
}
