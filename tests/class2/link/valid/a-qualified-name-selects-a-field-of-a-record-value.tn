!!id:"https://tson.io/test-suite/class2/link/valid/a-qualified-name-selects-a-field-of-a-record-value.tn"
!!import:"https://tson.io/2026/40/m/meta.tn"
!!import:"https://tson.io/2026/40/m/core.tn"
!schema {
  endpoint  => { path: text }
  station   => { main: endpoint  backup?: endpoint }
  st        => !station { main: { path: "/a" } }
  endpoints => meta.ref<endpoint>
  ep_pick   => { e: endpoints }
  ep        => !ep_pick { e: st.main }
}
