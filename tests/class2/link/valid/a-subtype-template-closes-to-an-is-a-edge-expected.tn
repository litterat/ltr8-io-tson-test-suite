!!id:"https://tson.io/test-suite/class2/link/valid/a-subtype-template-closes-to-an-is-a-edge-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.8, [TSON-SCHEMA] §5.10, [TSON-SCHEMA] §8.2"
  description: "A template composing its base at its own parameter carries the application, not a head name, so closing mints an IS-A edge to the instantiation the arguments name. result_of_text indexes ok_of_text and err_of_text; result_of_int indexes only ok_of_int. An edge recorded as the head name alone would hold of every instantiation at once. Each member is named by the declaration that closed it, a declared application being the entry rather than a reference to a content-named one (§8.2)."
  meta: "meta.tn"
  import: ["core.tn"]
  valid: {
    subtypes: [
      { name: result_of_text  subtypes: [ok_of_text err_of_text] }
      { name: result_of_int  subtypes: [ok_of_int] }
      { name: ok_of_text  subtypes: [] }
    ]
  }
}
