!!id:"https://tson.io/test-suite/class2/link/valid/a-sealed-family-indexes-its-members.tn"
!!import:"https://tson.io/2026/39/m/meta.tn"
!!import:"https://tson.io/2026/39/m/core.tn"
!schema {
  pet => abstract {
    pet_type: text =?
    name: text
  }

  dog => pet & {
    pet_type?: = "dog"
    breed: text
  }

  cat => pet & {
    pet_type?: = "cat"
    indoor: boolean
  }
}
