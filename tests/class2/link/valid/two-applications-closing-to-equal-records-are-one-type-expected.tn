!!id:"https://tson.io/test-suite/class2/link/valid/two-applications-closing-to-equal-records-are-one-type-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.8, [TSON-SCHEMA] §8.2"
  description: """
    Two records in place are one type when their bodies are equal, whichever parametric records produced them:
    `box<int32>` and `crate<int32>` close to one field list, so restating an inherited `f: box<int32>` as `f:
    crate<int32>` restates the inherited type and is accepted.
    """
  valid: {
    binds: [sub]
    subtypes: [
      { name: base  subtypes: [sub] }
    ]
  }
}
