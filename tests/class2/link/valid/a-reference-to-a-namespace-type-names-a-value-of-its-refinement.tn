!!id:"https://tson.io/test-suite/class2/link/valid/a-reference-to-a-namespace-type-names-a-value-of-its-refinement.tn"
!!import:"https://tson.io/2026/40/m/meta.tn"
!!import:"https://tson.io/2026/40/m/core.tn"
!schema {
  api   => !meta.namespace { key_type: meta.identifier  value_type: text }
  small => !api ^ { max_items: 2 }
  mine  => !small { get => "x" }
  apis  => meta.ref<api>
  slot  => { a: apis }
  held  => !slot { a: mine }
}
