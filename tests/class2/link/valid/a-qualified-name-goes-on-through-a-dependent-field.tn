!!id:"https://tson.io/test-suite/class2/link/valid/a-qualified-name-goes-on-through-a-dependent-field.tn"
!!import:"https://tson.io/2026/40/m/meta.tn"
!!import:"https://tson.io/2026/40/m/core.tn"
!schema {
  setting   => { kind: meta.type_ref  value?: kind! }
  port      => !setting { kind: text  value: "8080" }
  texts     => meta.ref<text>
  text_pick => { t: texts }
  chosen    => !text_pick { t: port.value }
}
