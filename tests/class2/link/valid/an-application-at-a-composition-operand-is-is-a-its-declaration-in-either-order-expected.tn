!!id:"https://tson.io/test-suite/class2/link/valid/an-application-at-a-composition-operand-is-is-a-its-declaration-in-either-order-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.7, [TSON-SCHEMA] §5.8, [TSON-SCHEMA] §5.10 (inline types, proposed for Revision 40)"
  description: """
    A composition of an application is IS-A its head's written parents and the declaration naming
    the application, wherever that declaration stands: `early` and `late` are each IS-A `base` and `text_box`,
    and nothing is IS-A `box`, no application being IS-A its head.
    """
  valid: {
    subtypes: [
      { name: base  subtypes: [text_box early late] }
      { name: text_box  subtypes: [early late] }
      { name: box  subtypes: [] }
    ]
  }
}
