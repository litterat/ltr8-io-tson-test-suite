!!id:"https://tson.io/test-suite/class2/link/valid/a-reference-follows-the-merge-of-the-synthetic-it-names-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §5.10, [TSON-SCHEMA] §8.2"
  description: """
    `[box<text>]` is lifted where it is written, before `box<text>` has an entry, and §8.2's merge pass settles it
    onto the one entry its resolved form names. A reference's `of` is a reference like any other, so `boxes`
    follows the merge and names that entry, the one `direct.d` names, and the schema links.
    """
  valid: {
    binds: [boxes direct]
  }
}
