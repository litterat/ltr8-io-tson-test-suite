!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §5.12"
  description: """
    What `of` names decides what a reference holds, never the template that spelled it. `record` is a
    constructor, so `ref<record>` is the same reference as `kind<record>`: its values are types' names, and
    `widget`, whose value is of `record`, is one.
    """
  valid: {
    binds: [records holder held]
  }
}
