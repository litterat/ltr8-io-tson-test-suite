{
  spec: "[TSON-SCHEMA] §7.2, [TSON-SCHEMA] §5.7"
  description: """
    A refined namespace type is IS-A its source, so a value tagged `!small` is admitted at a field typed `api`, and
    is read as a `small`.
    """
  valid: {
    binds: [small holder h]
  }
}
