!!id:"https://tson.io/test-suite/class2/link/valid/a-completion-is-a-member-of-its-constructors-kind-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §5.5 (incomplete entries, proposed for Revision 40)"
  description: """
    `nonempty` is an incomplete entry, no type and no kind's member. `texts => nonempty<text>` completes it into
    `!meta.array { element_type: text  min_items: 1 }`, an entry built with `meta.array` as `plain` is, so the kind
    over `meta.array` holds both beside the kernel's own sets; `nonempty` is not among them. The same two forms
    written at `post`'s fields are written in place, entries of nothing and so members of no kind.
    """
  valid: {
    binds: [texts plain post]
    members: [
      { name: arrays
        members: [meta.enum_set net.scheme_set numeric.integer_member_set unicode.text_member_set plain texts] }
    ]
  }
}
