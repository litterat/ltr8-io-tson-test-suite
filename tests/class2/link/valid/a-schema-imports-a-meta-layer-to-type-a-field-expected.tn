!!id:"https://tson.io/test-suite/class2/link/valid/a-schema-imports-a-meta-layer-to-type-a-field-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §2.2.3"
  description: """
    This schema imports meta.tn, and imports meta-headers.tn, a meta layer that imports the meta-kernel, to type
    a field by its namespace type `headers`. The layer's namespace is this schema's, as any import's is, and
    `headers` types the field as any imported type does.
    """
  valid: {
    binds: [request headers]
  }
}
