!!id:"https://tson.io/test-suite/class2/link/valid/a-kind-of-a-namespace-type-names-its-values-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §5.12"
  description: """
    A slot over `T` holds a name exactly when the type of the named entry's value IS-A `T`. `api` is a namespace
    type and no constructor, so the values `meta.ref<api>` admits are values, and `myops`, whose value is of `api`,
    is a name it holds.
    """
  valid: {
    binds: [apis api_slot api_held]
  }
}
