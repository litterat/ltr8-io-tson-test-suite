!!id:"https://tson.io/test-suite/class2/link/valid/a-compound-keyed-map-has-no-class.tn"
!!import:"https://tson.io/2026/39/m/meta.tn"
!!import:"https://tson.io/2026/39/m/core.tn"
!schema {
  point => {
    x: int32
    y: int32
  }

  by_point => { point => text }
  by_name  => { text => text }

  keyed_choice => ( by_point | int32 )
  named_choice => ( by_name | int32 )
}
