!!id:"https://tson.io/test-suite/class2/link/valid/a-field-typed-by-a-kernel-type-core-reaches-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §2.2.3"
  description: """
    core.tn imports meta.tn, the kernel, and an import contributes its whole namespace, so a schema importing
    core types a field by a kernel entry core names nowhere at its root, by its path: `meta.field_name`, the
    kernel's alias of `meta.identifier`, beside `identifier`, core's alias of the same entry.
    """
  valid: {
    binds: [user identifier meta.field_name meta.identifier meta.record]
  }
}
