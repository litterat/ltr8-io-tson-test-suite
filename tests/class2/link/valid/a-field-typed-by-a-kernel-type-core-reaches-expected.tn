!!id:"https://tson.io/test-suite/class2/link/valid/a-field-typed-by-a-kernel-type-core-reaches-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §2.2.3"
  description: """
    core.tn imports meta.tn, which imports the meta-kernel, and an import contributes its whole namespace, so
    a schema importing core types a field by a kernel entry core never declares: `identifier`, and
    `field_name`, the kernel's alias of it.
    """
  meta: "meta.tn"
  import: ["core.tn"]
  valid: {
    binds: [user identifier field_name record]
  }
}
