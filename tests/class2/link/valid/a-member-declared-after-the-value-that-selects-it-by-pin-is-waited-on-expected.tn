!!id:"https://tson.io/test-suite/class2/link/valid/a-member-declared-after-the-value-that-selects-it-by-pin-is-waited-on-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §3.4.1 (the wait order, proposed), [TSON-SCHEMA] §5.2, [TSON-SCHEMA] §6"
  description: """
    A value read at a family's selectors whose pin no ready member states waits on each declaration that may be that
    member. `reader`'s annotation is read while `reader` is made ready, before `rss_feed`: no member the closure
    holds so far pins `format` to `rss`, and `rss_feed` composes `feed` and writes that pin, so the read waits on
    `rss_feed` and the value is that member, as it is once every entry is ready.
    """
  valid: {
    binds: [reader rss_feed]
    subtypes: [
      { name: feed  subtypes: [atom_feed rss_feed] }
    ]
  }
}
