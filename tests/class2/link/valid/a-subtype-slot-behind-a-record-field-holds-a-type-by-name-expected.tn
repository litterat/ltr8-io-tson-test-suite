!!id:"https://tson.io/test-suite/class2/link/valid/a-subtype-slot-behind-a-record-field-holds-a-type-by-name-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.6, [TSON-SCHEMA] §7.2, [TSON-SCHEMA] §8.3 (values by name, proposed as §5.12)"
  description: "The request slot is declared by typed_call alone, a member of the family base service_call that service_resource's calls field holds, so the slot is reached through a record field and a tag. Its declared type is kind<record> wherever the value sits, and order, a record declared in this schema, is a member of it."
  valid: {
    binds: [shop order]
  }
}
