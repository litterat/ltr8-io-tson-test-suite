!!id:"https://tson.io/test-suite/class2/link/valid/a-declared-application-is-the-entry-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §8.2 (inline types, proposed for Revision 40)"
  description: """
    A declaration whose body is a fully-bound application is the closed record itself, under its author's name, and
    carries the application on its key: `text_box` is the record `{ value: text }`. It is the one name the
    application has, an application never being looked up at a slot. An open record is no type, so `text_box` is
    not IS-A `box` and `box` indexes nothing.
    """
  valid: {
    binds: [box text_box]
    subtypes: [
      { name: box  subtypes: [] }
    ]
  }
}
