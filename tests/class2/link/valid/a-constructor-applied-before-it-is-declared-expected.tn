!!id:"https://tson.io/test-suite/class2/link/valid/a-constructor-applied-before-it-is-declared-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §3.4.1 (the wait order, proposed), [TSON-SCHEMA] §5.5"
  description: """
    `counts` applies `counted`, a constructor the same document declares after it. Reading the instance
    waits on its constructor being ready, which the processor makes it first: the order entries are written
    in is not consulted, and a constructor and its instance share a document in either order.
    """
  valid: {
    binds: [counts counted]
  }
}
