!!id:"https://tson.io/test-suite/class2/link/valid/an-importer-applies-a-constructor-an-ordinary-library-declares-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §2.2.3, [TSON-SCHEMA] §4.1, [TSON-SCHEMA] §5.5"
  description: """
    Any schema may declare a constructor: link-steps.tn is an ordinary library, importing meta.tn, and
    declares the namespace type `steps`. This schema imports it, so `steps` is in its namespace, and `plan`
    applies it: an entry holding a map of text under identifier keys.
    """
  valid: {
    binds: [plan steps]
  }
}
