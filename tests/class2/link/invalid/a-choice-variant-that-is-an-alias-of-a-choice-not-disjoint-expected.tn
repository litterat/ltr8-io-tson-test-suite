!!id:"https://tson.io/test-suite/class2/link/invalid/a-choice-variant-that-is-an-alias-of-a-choice-not-disjoint-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.4, [TSON-SCHEMA] §8.3"
  description: """
    Whether a variant is a choice is judged after following its alias chain: `held` is an alias of `either`, a
    choice of two records that is not disjoint, so `( text | held )` is refused as `( text | either )` is, a
    resolver error at the declaration. A resolver that asks only whether the variant's own entry is a choice body
    loads it.
    """
  error: {
    category: resolver
  }
}
