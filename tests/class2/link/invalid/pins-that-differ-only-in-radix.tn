!!id:"https://tson.io/test-suite/class2/link/invalid/pins-that-differ-only-in-radix.tn"
!!import:"https://tson.io/2026/39/m/meta.tn"
!!import:"https://tson.io/2026/39/m/core.tn"
!schema {
  frame => abstract {
    opcode: int32 =?
    payload: text
  }

  ping => frame & {
    opcode?: = 255
  }

  pong => frame & {
    opcode?: = 0xFF
  }
}
