!!id:"https://tson.io/test-suite/class2/link/invalid/a-value-entry-of-a-refined-namespace-type-above-its-ceiling-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §5.7"
  description: """
    A value of a refined namespace type is judged under the narrowed bounds: `three` holds three entries against
    `small`'s `max_items: 2`, though `api` would admit it. A value entry is read when the schema loads, so the
    refusal is the schema's, a resolver error.
    """
  error: {
    category: resolver
  }
}
