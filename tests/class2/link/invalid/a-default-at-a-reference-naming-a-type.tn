!!id:"https://tson.io/test-suite/class2/link/invalid/a-default-at-a-reference-naming-a-type.tn"
!!import:"https://tson.io/2026/40/m/meta.tn"
!!import:"https://tson.io/2026/40/m/core.tn"
!schema {
  order          => { id: text }
  customer       => { name: text }
  o1             => !order { id: A-1 }
  c1             => !customer { name: Ada }
  order_ref      => meta.ref<order>
  defaulted_pick => { which?: order_ref ~ order }
}
