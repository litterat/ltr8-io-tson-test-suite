!!id:"https://tson.io/test-suite/class2/link/invalid/a-parametric-records-restatement-refused-for-an-application-closed-in-place-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.8, [TSON-SCHEMA] §5.10"
  description: """
    A restatement in a parametric record is judged with each application's arguments wherever the
    application closes, at a field's type as at a declaration. `wrap<text>` closes in place at `w` to a
    record restating `box<text>`'s `v: text` as `int32`, which is neither `text` nor IS-A it, so the schema
    does not load.
    """
  error: {
    category: resolver
  }
}
