!!id:"https://tson.io/test-suite/class2/link/invalid/a-braced-application-at-a-kind-typed-slot-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.6, [TSON-SCHEMA] §8.2"
  description: "A kind-typed slot of a value body holds a type's name, one bare token. Nothing lifts or mints in a value body, so the braced application box<order> would have no entry to be the name of; it is refused, and the alias spelling (order_box => box<order>, then request: order_box) gives it one."
  meta: "fixtures/meta-service.tn"
  import: ["fixtures/link-orders-interface.tn"]
  error: {
    category: resolver
  }
}
