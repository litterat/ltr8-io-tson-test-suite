!!id:"https://tson.io/test-suite/class2/link/invalid/a-default-at-an-inline-reference-naming-nothing.tn"
!!import:"https://tson.io/2026/39/m/meta.tn"
!!import:"https://tson.io/2026/39/m/core.tn"
!schema {
  order          => { id: text }
  customer       => { name: text }
  o1             => !order { id: A-1 }
  c1             => !customer { name: Ada }
  order_ref      => meta.ref<order>
  defaulted_pick => { which?: meta.ref<order> ~ nope }
}
