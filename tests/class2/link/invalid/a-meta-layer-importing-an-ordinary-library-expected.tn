!!id:"https://tson.io/test-suite/class2/link/invalid/a-meta-layer-importing-an-ordinary-library-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §2.2.3, [TSON-SCHEMA] §3.1"
  description: """
    The other direction of the same rule. This schema is governed by the meta-kernel, and it imports
    link-money.tn, an ordinary library governed by meta.tn, for `money`. An import stands at the importer's
    governing level, so a kernel-governed schema declares the vocabulary its constructors use rather than
    importing an ordinary schema's, and the import is refused. The schema imports nothing else, so no other
    rule refuses its closure.
    """
  meta: "meta-kernel.tn"
  import: ["fixtures/link-money.tn"]
  error: {
    category: resolver
  }
}
