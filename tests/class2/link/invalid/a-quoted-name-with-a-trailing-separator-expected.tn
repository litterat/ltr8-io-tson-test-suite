!!id:"https://tson.io/test-suite/class2/link/invalid/a-quoted-name-with-a-trailing-separator-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.12"
  description: """
    A reference's text splits at `.`, and no segment is empty: a trailing `.` leaves an empty last segment, so
    `"orders.place_order."` is no name, quoted as unquoted.
    """
  error: {
    category: resolver
  }
}
