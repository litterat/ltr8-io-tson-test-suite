!!id:"https://tson.io/test-suite/class2/link/invalid/an-application-at-a-kind-typed-slot-of-a-value-body-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.6, [TSON-SCHEMA] §5.10 (inline types, proposed for Revision 40)"
  description: """
    A kind-typed slot of a value body holds a type's name, one bare token. An application of an open record is
    never looked up as a name, and a value body's slot does not close one in place, so `box<order>` there names
    no entry and is refused; the declaration `order_box => box<order>`, then `request: order_box`, names it.
    """
  error: {
    category: resolver
  }
}
