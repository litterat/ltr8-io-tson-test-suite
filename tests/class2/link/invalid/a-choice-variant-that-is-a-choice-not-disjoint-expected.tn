!!id:"https://tson.io/test-suite/class2/link/invalid/a-choice-variant-that-is-a-choice-not-disjoint-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.4 (nested choices, proposed for Revision 40)"
  description: """
    A variant that is a choice is disjoint. A nested choice has no class, so `( text | either )` is not disjoint and
    a value of `either` carries the tag naming it; with its one tag spent, it is read at `either` untagged, and
    `either`, two records, is not disjoint, so a value of `a` or of `b` has no spelling. It is a resolver error at
    the declaration; the choice is written with the variants listed, `( text | a | b )`.
    """
  error: {
    category: resolver
  }
}
