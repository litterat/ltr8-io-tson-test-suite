!!id:"https://tson.io/test-suite/class2/link/invalid/a-discriminator-without-abstract-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2"
  description: "A field written '=?' says the members of this record pin it, so the record is the base they are selected from and has no values of its own -- which the declaration must state. Instantiability is not derivable from a field, so '@abstract' is required; that the family is member-dispatched rather than tag-dispatched is derived from the field and needs no second mark."
  meta: "meta.tn"
  import: ["core.tn"]
  error: {
    category: resolver
  }
}
