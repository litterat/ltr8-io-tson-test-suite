!!id:"https://tson.io/test-suite/class2/link/invalid/an-ordinary-schema-importing-a-meta-layer-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §2.2.3, [TSON-SCHEMA] §3.1"
  description: """
    An import stands at the importer's governing level: both schemas name the meta-kernel as their `!!meta`, or
    neither. This schema is governed by meta.tn and imports meta-headers.tn, a meta layer the meta-kernel governs,
    to type a field by its namespace type `headers`. A meta layer's vocabulary reaches a schema only as that
    schema's `!!meta`, so the import is refused and the schema does not load.
    """
  meta: "meta.tn"
  import: ["fixtures/meta-headers.tn"]
  error: {
    category: resolver
  }
}
