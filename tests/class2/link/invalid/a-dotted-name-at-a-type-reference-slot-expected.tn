!!id:"https://tson.io/test-suite/class2/link/invalid/a-dotted-name-at-a-type-reference-slot-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.6, [TSON-SCHEMA] §7.2, [TSON-SCHEMA] §8.3 (values by name, proposed as §5.12)"
  description: "response is typed type_ref, whose one field name is a type_name, so its bare token is read positionally as a type name, and a dotted token is no type name. A value by name stands only where a bare token is not the positional field's value."
  error: {
    category: resolver
  }
}
