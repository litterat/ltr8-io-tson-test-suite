!!id:"https://tson.io/test-suite/class2/link/invalid/a-value-entry-named-at-a-type-position-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.1, [TSON-SCHEMA] §4.2"
  description: """
    An entry is a type exactly when its value is built by a constructor IS-A `type`. `chosen` is a value of the
    record type `api_pick`, built by no constructor, so it is no member of `type_kind`, unmarked: the field `x`,
    whose type slot is typed `type_kind`, names a value, and the schema is refused.
    """
  error: {
    category: resolver
  }
}
