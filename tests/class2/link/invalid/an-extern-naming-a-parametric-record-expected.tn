!!id:"https://tson.io/test-suite/class2/link/invalid/an-extern-naming-a-parametric-record-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.13"
  description: """
    An extern names a type a value can have, declared anywhere in its schema's closure; `box` is a parametric
    record, which a reference names only as the head of an application, so the extern is refused, and with it the
    schema declaring it.
    """
  error: { category: resolver }
}
