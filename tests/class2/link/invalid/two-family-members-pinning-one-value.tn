!!id:"https://tson.io/test-suite/class2/link/invalid/two-family-members-pinning-one-value.tn"
!!import:"https://tson.io/2026/39/m/meta.tn"
!!import:"https://tson.io/2026/39/m/core.tn"
!schema {
  pet => abstract {
    pet_type: text =?
    name: text
  }

  dog => pet & {
    pet_type?: = "dog"
    breed: text
  }

  hound => pet & {
    pet_type?: = "dog"
    scent: text
  }
}
