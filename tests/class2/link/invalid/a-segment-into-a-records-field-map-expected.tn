!!id:"https://tson.io/test-suite/class2/link/invalid/a-segment-into-a-records-field-map-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.1, [TSON-SCHEMA] §8.3 (values by name, proposed as §5.12)"
  description: """
    A segment selects a key of a namespace value or a field of a record value, and nothing else. `point.p` is a
    `form`, whose `fields` is a `meta.field_map`: an ordered map keyed by text, a field name being text within its
    own record and judged by its `name_type`, and no namespace. No qualified name enters it, so
    `point.p.fields.x` names nothing.
    """
  error: {
    category: resolver
  }
}
