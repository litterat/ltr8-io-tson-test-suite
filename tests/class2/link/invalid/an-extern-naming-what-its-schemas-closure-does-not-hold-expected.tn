!!id:"https://tson.io/test-suite/class2/link/invalid/an-extern-naming-what-its-schemas-closure-does-not-hold-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.13"
  description: """
    An extern names a type a value can have, declared anywhere in its schema's closure; `line` is a name that
    schema's closure does not hold (`line` is extern-order-2.tn's), so the extern is refused, and with it the
    schema declaring it.
    """
  error: { category: resolver }
}
