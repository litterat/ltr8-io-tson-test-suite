!!id:"https://tson.io/test-suite/class2/link/invalid/an-extern-naming-a-schema-map-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.13"
  description: """
    An extern names a type a value can have, declared anywhere in its schema's closure; `geo` is a schema map,
    which is no one type, so the extern is refused, and with it the schema declaring it.
    """
  error: { category: resolver }
}
