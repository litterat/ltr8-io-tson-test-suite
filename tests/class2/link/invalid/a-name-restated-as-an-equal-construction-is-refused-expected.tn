!!id:"https://tson.io/test-suite/class2/link/invalid/a-name-restated-as-an-equal-construction-is-refused-expected.tn"
!!import:"https://tson.io/test-suite/schemas/link-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.7, [TSON-SCHEMA] §8.2 (inline types, proposed for Revision 40)"
  description: """
    A restated field's type is the inherited type or IS-A it, and a name and a construction are never the same type:
    `[text]` written in place has the shape `text_list` declares but is not `text_list`, and nothing is IS-A a type
    written in place or IS-A from one, so restating `tags` as `[text]` is refused.
    """
  error: {
    category: resolver
  }
}
