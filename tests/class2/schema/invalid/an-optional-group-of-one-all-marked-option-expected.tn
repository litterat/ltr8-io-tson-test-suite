!!id:"https://tson.io/test-suite/class2/schema/invalid/an-optional-group-of-one-all-marked-option-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.11"
  description: "A `?` group of one option whose members are all marked admits every combination of them, which is `a?: text  b?: text`; the grammar refuses the second spelling."
  meta: "meta.tn"
  import: ["core.tn"]
  error: {
    category: resolver
  }
}
