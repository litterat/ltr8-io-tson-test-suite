!!id:"https://tson.io/test-suite/class2/schema/invalid/a-tag-is-no-sibling-reference-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-DATA] §7.4, [TSON-SCHEMA] §12.1"
  description: """
    A tag is `!` and a qualified name, and a sibling reference is no qualified name, so `!int32!` does not parse: the
    trailing `!` would make the tag's name a sibling reference, and a tag names a type. Category is `resolver` even
    though the failure is a parse one, since §8.1 makes every error that stops a schema loading a resolver error.
    """
  error: {
    category: resolver
  }
}
