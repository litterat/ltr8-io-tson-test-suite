!!id:"https://tson.io/test-suite/class2/schema/invalid/a-plain-supertypes-name-outside-the-compositions-name-type.tn"
{
  json_name => !identifier_type { start_add: "@$" }
  json_record => !record { name_type: json_name  extension: ABSTRACT  fields: [] }
  order => { order-id: text }
  node => json_record & order & { "@id": text }
}
