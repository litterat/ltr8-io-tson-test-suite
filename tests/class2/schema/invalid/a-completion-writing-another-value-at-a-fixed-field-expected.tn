!!id:"https://tson.io/test-suite/class2/schema/invalid/a-completion-writing-another-value-at-a-fixed-field-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2, §5.5"
  description: """
    A completion may write a field its incomplete entry left unwritten, and a fixed field there takes only
    the pin's value (§5.2): `meta.array` pins `access_pattern` to `INDEX`, and `NAMED` contradicts it.
    """
  error: {
    category: resolver
  }
}
