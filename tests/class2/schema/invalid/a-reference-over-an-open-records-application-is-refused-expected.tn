!!id:"https://tson.io/test-suite/class2/schema/invalid/a-reference-over-an-open-records-application-is-refused-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §5.10 (inline types, proposed for Revision 40)"
  description: """
    A reference's `of` holds a name, and an application of an open record is never looked up as one, so
    `meta.ref<box<text>>` is refused: the application is declared, `text_box => box<text>`, and `meta.ref<text_box>`
    written.
    """
  error: {
    category: resolver
  }
}
