!!id:"https://tson.io/test-suite/class2/schema/invalid/a-caret-after-an-application-is-a-parse-error-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.7, [TSON-SCHEMA] §12.1 (`^` follows `!name`, proposed for Revision 40)"
  description: """
    An application of an open record before `^` is a bare reference, and a parse error: the substituted record's
    fields are restated in a composition, `box<text> & { v?: = a }`.
    """
  error: {
    category: resolver
  }
}
