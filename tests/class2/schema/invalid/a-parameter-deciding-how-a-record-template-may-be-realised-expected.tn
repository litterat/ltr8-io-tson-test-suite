!!id:"https://tson.io/test-suite/class2/schema/invalid/a-parameter-deciding-how-a-record-template-may-be-realised-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10"
  description: """
    `E` would decide each application's extensibility, which an open record states as written for every application.
    A parameter is a type, and stands only at a field's type or as an argument of an application there or in a parent,
    so a parameter at `meta.record.extension` is refused at the declaration, naming the slot.
    """
  error: {
    category: resolver
  }
}
