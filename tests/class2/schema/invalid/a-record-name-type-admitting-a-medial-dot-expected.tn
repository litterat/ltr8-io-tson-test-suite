!!id:"https://tson.io/test-suite/class2/schema/invalid/a-record-name-type-admitting-a-medial-dot-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2, [TSON-SCHEMA] §5.12 (reference reach, proposed for Revision 40)"
  description: """
    A `name_type` admits U+002E at no position of its profile, Medial included: `dotted` admits `.` only between two
    characters, which is where a segment would be split, so `row` naming it is refused.
    """
  error: {
    category: resolver
  }
}
