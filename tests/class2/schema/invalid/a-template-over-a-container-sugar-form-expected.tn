!!id:"https://tson.io/test-suite/class2/schema/invalid/a-template-over-a-container-sugar-form-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §5.3"
  description: """
    A template's body is a record body, and `[T]` is an array, the construction `meta.array<T>`, which carries no
    parameters. The declaration is refused; a use site writes the application it means, `[uuid]` or
    `meta.array<uuid>`.
    """
  error: {
    category: resolver
  }
}
