!!id:"https://tson.io/test-suite/class2/schema/invalid/a-schema-importing-core-declares-a-kernel-name-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §2.2.3"
  description: """
    core.tn imports meta.tn, which imports the meta-kernel, and an import contributes its whole namespace, so
    the kernel's `identifier` is bound in this schema's closure. A local declaration may not reuse a name the
    closure binds, and a schema's own identifier profile is declared under a name of its own.
    """
  error: {
    category: resolver
  }
}
