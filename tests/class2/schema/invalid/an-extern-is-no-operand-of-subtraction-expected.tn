!!id:"https://tson.io/test-suite/class2/schema/invalid/an-extern-is-no-operand-of-subtraction-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.13 (externs, proposed for Revision 40)"
  description: """
    An extern is sealed: it names another schema's type as that schema declares it, so it is never an operand of
    `-`.
    """
  error: { category: resolver }
}
