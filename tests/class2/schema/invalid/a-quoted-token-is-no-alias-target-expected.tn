{
  spec: "[TSON-SCHEMA] §8.3, [TSON-SCHEMA] §5.12, [TSON-SCHEMA] §12.1 (reference reach, proposed for Revision 40)"
  description: """
    An alias's target is a `type-expr` of the schema grammar, a name written unquoted: `"text"` is no type
    definition, so the declaration does not parse.
    """
  error: {
    category: resolver
  }
}
