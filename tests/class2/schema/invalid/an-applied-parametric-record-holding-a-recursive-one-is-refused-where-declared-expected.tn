!!id:"https://tson.io/test-suite/class2/schema/invalid/an-applied-parametric-record-holding-a-recursive-one-is-refused-where-declared-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10.1"
  description: """
    A parametric record holding an application of a recursive parametric record it is not on a cycle of could never
    be closed, and is refused at its own declaration: `wrap` holds `n: node<T>`, which closes in place wherever
    `wrap` is applied, and `node`'s recursion ties only to a declaration closing `node` itself, never to
    `node_text` or to `wrap_text`. The resolver error is `wrap`'s; `wrap_text`, which applies it, carries none.
    """
  error: {
    category: resolver
  }
}
