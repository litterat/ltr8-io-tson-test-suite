{
  spec: "[TSON-SCHEMA] §5.11"
  description: "A bare group of one option is always chosen, so its unmarked members are required and its marked ones optional: it states `a: text  b?: text`, and the grammar refuses the second spelling."
  meta: "meta.tn"
  import: ["core.tn"]
  error: {
    category: resolver
  }
}
