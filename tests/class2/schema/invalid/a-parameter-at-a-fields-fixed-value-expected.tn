!!id:"https://tson.io/test-suite/class2/schema/invalid/a-parameter-at-a-fields-fixed-value-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10"
  description: """
    A field's value is never a parameter. `S` pins `status`, so the declaration is refused, naming the slot; a pin
    that differs per application is written where the application is declared, `created => response<order> & {
    status?: = 201 }`.
    """
  error: {
    category: resolver
  }
}
