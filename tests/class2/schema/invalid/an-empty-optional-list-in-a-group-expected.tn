!!id:"https://tson.io/test-suite/class2/schema/invalid/an-empty-optional-list-in-a-group-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.11, [TSON-SCHEMA] §8.1"
  description: """
    An absent `optional` names no member, so an empty one is a second spelling of absence:
    `field_group.optional` is `[field_name; 1..]`, and an empty list is not valid data for it.
    """
  meta: "meta.tn"
  import: ["core.tn"]
  error: {
    category: resolver
  }
}
