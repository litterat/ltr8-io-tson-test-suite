!!id:"https://tson.io/test-suite/class2/schema/invalid/a-parameter-deciding-a-fields-role-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10"
  description: """
    `R` decides whether `v`'s value is a default or fixed, so the family base cannot say what its members admit. A
    record template's parameters stand only in a field's type, a field's default or fixed value, or an argument of
    an application.
    """
  meta: "meta.tn"
  import: ["core.tn"]
  error: {
    category: resolver
  }
}
