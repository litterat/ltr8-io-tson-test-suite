!!id:"https://tson.io/test-suite/class2/schema/invalid/a-kind-of-data-is-refused-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §3.3.1"
  description: "A kind's `of` names a constructor of the structure namespace that is `type` or below it. `data` is a kernel constructor beside `type`, not below it: no value has a type built with it, so `kind<data>` would name no type a value can have, and is a resolver error at the declaration rather than an empty kind."
  meta: "meta.tn"
  import: ["core.tn"]
  error: {
    category: resolver
  }
}
