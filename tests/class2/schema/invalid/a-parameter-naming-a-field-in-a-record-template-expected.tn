!!id:"https://tson.io/test-suite/class2/schema/invalid/a-parameter-naming-a-field-in-a-record-template-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10"
  description: """
    A parameter is a type, and stands only at a field's type or as an argument of an application there or in a
    parent. `K` names the field, so the family base cannot list it: the declaration is refused, whether or not
    anything applies it.
    """
  error: {
    category: resolver
  }
}
