!!id:"https://tson.io/test-suite/class2/schema/invalid/a-parameter-naming-a-field-in-a-record-template-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10"
  description: """
    A record template's parameters stand only in a field's type, a field's default or fixed value, or an argument of
    an application. `K` names the field, so the family base cannot list it: the declaration is refused, whether or
    not anything applies it.
    """
  error: {
    category: resolver
  }
}
