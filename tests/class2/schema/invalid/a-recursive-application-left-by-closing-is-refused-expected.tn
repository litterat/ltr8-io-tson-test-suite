!!id:"https://tson.io/test-suite/class2/schema/invalid/a-recursive-application-left-by-closing-is-refused-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10.1 (inline types, proposed for Revision 40)"
  description: """
    A recursive application left at a slot by closing another has nothing to tie to either: `wrap_text => wrap<text>`
    leaves `n: node<text>`, which closes in place and reaches itself at `next`. The declaration being closed is
    `wrap_text`, not one of `node<text>`, so `wrap_text` is a resolver error.
    """
  error: {
    category: resolver
  }
}
