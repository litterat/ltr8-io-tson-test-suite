!!id:"https://tson.io/test-suite/class2/schema/invalid/a-parameter-naming-a-record-templates-name-type-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10"
  description: """
    `I` decides what the field names are, so the family base's own names would mean something different in each
    member. A parameter is a type, and stands only at a field's type or as an argument of an application there or in
    a parent.
    """
  error: {
    category: resolver
  }
}
