!!id:"https://tson.io/test-suite/class2/schema/invalid/a-dependent-type-naming-no-field-in-explicit-form-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2, [TSON-SCHEMA] §8.1"
  description: """
    A dependent type's `on` names a field of the same record and never a schema entry: `kind` is declared at the root,
    but `cell` has no field `kind`, so `{ of: !meta.dependent { on: kind } }` names nothing and is refused.
    """
  error: {
    category: resolver
  }
}
