!!id:"https://tson.io/test-suite/class2/schema/invalid/a-refinement-of-a-namespace-type-writing-a-field-its-constructor-does-not-declare-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §5.7 (a namespace type refined, proposed for Revision 40)"
  description: """
    A refinement body is a closed record read against the constructor's vocabulary, and `meta.namespace` takes
    `meta.map`'s fields and adds `key_type`'s narrowing: `unique_items` is `meta.array`'s, declared by neither,
    so the member is refused rather than ignored.
    """
  error: {
    category: resolver
  }
}
