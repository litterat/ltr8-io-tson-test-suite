!!id:"https://tson.io/test-suite/class2/schema/invalid/the-explicit-record-form-writes-no-positional-record-field-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.6, [TSON-SCHEMA] §7.2, [TSON-SCHEMA] §8.3 (values by name, proposed as §5.12)"
  description: "In a schema document a bare name at a record position is a value by name, not a positional fill of a product-typed field: record_field's one field is type, a type_ref, a product, so p => x is refused here, where p => { type: x } is the field. A data document, which has no namespace to resolve a name in, still reads the same token positionally."
  meta: "meta.tn"
  import: ["core.tn"]
  error: {
    category: resolver
  }
}
