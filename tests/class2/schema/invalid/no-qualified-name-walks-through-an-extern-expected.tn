!!id:"https://tson.io/test-suite/class2/schema/invalid/no-qualified-name-walks-through-an-extern-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.13"
  description: """
    An extern is sealed: it names another schema's type as that schema declares it, so it is never walked
    through by a qualified name: the boundary is absolute ([TSON-SCHEMA] §5.12).
    """
  error: { category: resolver }
}
