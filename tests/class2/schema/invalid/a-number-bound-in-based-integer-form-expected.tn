!!id:"https://tson.io/test-suite/class2/schema/invalid/a-number-bound-in-based-integer-form-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.6 (a bound typed by its family's instance, proposed)"
  description: """
    `numeric.decimal_type`'s bounds are typed `number`, so `min` is spelled as a `number` is in data.
    `number` admits integer and float forms and no based integer (§5.6), so `0x10` is refused here as
    `!number 0x10` is in a document, and the schema does not load.
    """
  error: {
    category: resolver
  }
}
