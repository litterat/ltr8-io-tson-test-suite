!!id:"https://tson.io/test-suite/class2/schema/invalid/a-sibling-reference-followed-by-a-closing-bracket-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-DATA] §7.5, [TSON-SCHEMA] §12.3"
  description: """
    A postfix `!` is followed by whitespace, and a delimiter is not whitespace: `[kind!]` does not parse, so it fails
    before the position rule could refuse it. Written `[ kind! ]` it parses, and desugaring refuses it instead.
    Category is `resolver`, as every error that stops a schema loading is.
    """
  error: {
    category: resolver
  }
}
