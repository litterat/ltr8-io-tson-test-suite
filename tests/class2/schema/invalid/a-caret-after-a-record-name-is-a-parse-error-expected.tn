!!id:"https://tson.io/test-suite/class2/schema/invalid/a-caret-after-a-record-name-is-a-parse-error-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.7, [TSON-SCHEMA] §12.1 (`^` follows `!name`, proposed for Revision 40)"
  description: """
    `^` follows `!name` and its body is values, so after a bare name it is a parse error whatever the name is.
    A record's fields are restated in a composition, `vip => person & {}`.
    """
  error: {
    category: resolver
  }
}
