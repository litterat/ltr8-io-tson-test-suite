!!id:"https://tson.io/test-suite/class2/schema/invalid/applying-record-template-directly-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §8.1"
  description: """
    `record_template` is resolver vocabulary: a record template's body, derived from a record declared with type
    parameters. A source declaration applying it directly is a resolver error, even though it IS-A `top` --
    otherwise it would mint a record template that skipped every check §5.10 makes of a template's declaration.
    """
  error: {
    category: resolver
  }
}
