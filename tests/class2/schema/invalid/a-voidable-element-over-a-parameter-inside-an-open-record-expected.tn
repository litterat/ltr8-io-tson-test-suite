!!id:"https://tson.io/test-suite/class2/schema/invalid/a-voidable-element-over-a-parameter-inside-an-open-record-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §5.3"
  description: """
    Inside an open record a form over a parameter is admitted only where it is a reference. A `?` on the element sets
    the array's `voidable`, a field no argument list carries, so `[T?]` is no reference and the declaration is
    refused, naming the form.
    """
  error: {
    category: resolver
  }
}
