!!id:"https://tson.io/test-suite/class2/schema/invalid/a-discriminator-typed-by-an-application-of-a-parameter-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10"
  description: """
    `kind`'s type is `meta.ref<M>`, which varies with `M` as much as a type written `M` would: two applications
    would read the discriminator at two types. A selector, like a literal, needs a type closed in every application,
    so a parameter may not stand in it at any depth.
    """
  error: {
    category: resolver
  }
}
