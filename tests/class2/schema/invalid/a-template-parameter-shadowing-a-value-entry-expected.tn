!!id:"https://tson.io/test-suite/class2/schema/invalid/a-template-parameter-shadowing-a-value-entry-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10"
  description: """
    A parameter that shadows a schema entry is a resolver error, a value entry as much as a type: inside `boxed` the
    value entry `origin` would be unreachable, so `boxed` is refused at its declaration.
    """
  error: {
    category: resolver
  }
}
