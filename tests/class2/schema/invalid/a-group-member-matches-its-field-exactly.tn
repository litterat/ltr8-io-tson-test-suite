!!id:"https://tson.io/test-suite/class2/schema/invalid/a-group-member-matches-its-field-exactly.tn"
!!import:"https://tson.io/2026/40/m/meta.tn"
!!import:"https://tson.io/2026/40/m/core.tn"
!schema {
  folded => !unicode.identifier_type { normalization: NFKC_CASEFOLD }
  row => !meta.record { name_type: folded
    fields: { name => { type: text  optional: true } email => { type: text  optional: true } }
    groups: [ { members: [ [NAME] [email] ] } ] }
}
