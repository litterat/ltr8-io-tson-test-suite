!!id:"https://tson.io/test-suite/class2/schema/invalid/two-members-that-are-one-value-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §7.4"
  description: """
    A member is a value of its type, in the type's normalization form, and both members fold to
    `utf-8`: a set listing one value twice is not the set its author meant.
    """
  meta: "meta.tn"
  import: ["core.tn"]
  error: {
    category: resolver
  }
}
