!!id:"https://tson.io/test-suite/class2/schema/invalid/a-constructors-application-is-never-a-declarations-body-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §8.2 (an application is a construction, proposed for Revision 40)"
  description: """
    `meta.apply` is written in place and never as a declaration's body: `weird => !meta.apply { … }` over
    the constructor `meta.array` is a resolver error, a declared application being written `weird => meta.array<text>`, whose
    value is the type it closes or constructs to.
    """
  error: {
    category: resolver
  }
}
