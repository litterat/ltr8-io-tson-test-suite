!!id:"https://tson.io/test-suite/class2/schema/invalid/an-iri-is-never-normalized-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §5.7"
  description: """
    `iri_type` fixes its normalization to NONE: past the scheme and the host, an IRI compares with case
    (RFC 3987 §5.3.2.1), so a fold over the whole text would change which resource it names, and a
    construction stating another form contradicts the fixed field.
    """
  meta: "meta.tn"
  import: ["core.tn"]
  error: {
    category: resolver
  }
}
