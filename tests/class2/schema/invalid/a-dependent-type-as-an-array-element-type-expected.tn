!!id:"https://tson.io/test-suite/class2/schema/invalid/a-dependent-type-as-an-array-element-type-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2, [TSON-SCHEMA] §12.1"
  description: """
    The schema grammar reads a dependent type, `kind!`, only as a record field's type, a field group member's included,
    and never inside one: `[ kind! ]` is the field's type, and `kind!` stands inside it as the array's element type, so
    it does not parse, even though `cell` declares `kind` and the `!` is followed by whitespace. Category is `resolver`,
    as every error that stops a schema loading is.
    """
  error: {
    category: resolver
  }
}
