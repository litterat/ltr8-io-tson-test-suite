!!id:"https://tson.io/test-suite/class2/schema/invalid/a-sibling-declared-after-its-dependent-field-in-explicit-form.tn"
!!import:"https://tson.io/2026/40/m/meta.tn"
!!import:"https://tson.io/2026/40/m/core.tn"
!schema {
  cell => !meta.record { fields: {
    v    => !meta.record_field { type: { of: !meta.dependent { on: kind } }  optional: true }
    kind => !meta.record_field { type: meta.type_ref }
  } }
}
