!!id:"https://tson.io/test-suite/class2/schema/invalid/a-declaration-may-not-write-its-application-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §8.2"
  description: """
    `@application` is the resolver's: on an entry's key it states the application the entry is the
    instantiation of, written wherever an entry closes one, and a declaration never writes it, as it never
    writes `chain`. `bx` claims to be `box<text>` without being closed from it; `bx => box<text>` is
    the declaration that means it.
    """
  meta: "meta.tn"
  import: ["core.tn"]
  error: {
    category: resolver
  }
}
