!!id:"https://tson.io/test-suite/class2/schema/invalid/a-namespace-type-declaring-a-field-beside-its-facets-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.1, [TSON-SCHEMA] §7.2"
  description: """
    A namespace type is an instance of the kernel's `namespace`, whose vocabulary is `key_type`, `value_type` and
    `ordered`: a value of it is the map they describe, and nothing else. `interfaces` writes `extends` beside
    them, a field `namespace` does not declare, so the construction is refused as any record closed under its
    type refuses an unknown field. A construct with fields of its own is a record holding them, held under a key
    of a namespace type.
    """
  error: {
    category: resolver
  }
}
