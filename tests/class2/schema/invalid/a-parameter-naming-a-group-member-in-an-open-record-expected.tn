!!id:"https://tson.io/test-suite/class2/schema/invalid/a-parameter-naming-a-group-member-in-an-open-record-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10"
  description: """
    A group member is a field name, so `A` names a field, and an open record's field names are read at its
    declaration, as any record's are. A parameter is a type, and stands only at a field's type or as an argument of
    an application there or in a parent.
    """
  error: {
    category: resolver
  }
}
