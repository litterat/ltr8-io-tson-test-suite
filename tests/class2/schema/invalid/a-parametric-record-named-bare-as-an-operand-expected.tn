!!id:"https://tson.io/test-suite/class2/schema/invalid/a-parametric-record-named-bare-as-an-operand-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.8, [TSON-SCHEMA] §5.10"
  description: """
    `&` composes the fields of a record, and no position names a parametric record bare: its fields exist once its
    parameters are bound. `box & { … }` is a resolver error at `dog`; `box<text> & { … }` composes, and `dog` is
    then IS-A what `box`'s written parents reach, and never `box`.
    """
  error: {
    category: resolver
  }
}
