!!id:"https://tson.io/test-suite/class2/schema/invalid/a-regex-is-never-normalized-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §5.7"
  description: """
    `regex_type` fixes its normalization to NONE: putting a pattern into another form changes what it
    matches, so a regex is always its text as written, and a construction stating another form
    contradicts the fixed field.
    """
  meta: "meta.tn"
  import: ["core.tn"]
  error: {
    category: resolver
  }
}
