!!id:"https://tson.io/test-suite/class2/schema/invalid/an-unapplied-parametric-record-naming-an-unresolved-type-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §3.3.2"
  description: """
    A parametric record is read at its declaration, and a name its body writes that is neither one of its parameters
    nor in the schema's namespace is unresolved there, whether or not anything applies it: nothing applies `box`, and
    `w: no_such_type` is a resolver error at `box`. No argument can change what `no_such_type` resolves to.
    """
  error: {
    category: resolver
  }
}
