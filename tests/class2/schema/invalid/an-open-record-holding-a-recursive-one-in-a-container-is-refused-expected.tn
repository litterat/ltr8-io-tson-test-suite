!!id:"https://tson.io/test-suite/class2/schema/invalid/an-open-record-holding-a-recursive-one-in-a-container-is-refused-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §5.10.1 (inline types, proposed for Revision 40)"
  description: """
    An application held inside a type written in place closes where it stands: `{text => [node<T>]}` is the map
    whose value type holds the array in place, with `node<T>` at the array's element, closing in place there when
    `index` is applied. `node` is recursive and `index` is on no cycle of it, so `index` could never be
    closed and is a resolver error at its declaration.
    """
  error: {
    category: resolver
  }
}
