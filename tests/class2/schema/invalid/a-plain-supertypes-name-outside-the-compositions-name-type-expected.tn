!!id:"https://tson.io/test-suite/class2/schema/invalid/a-plain-supertypes-name-outside-the-compositions-name-type-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.8"
  description: """
    `order` states the kernel's default name type, so `node` takes `json_name` from `json_record`, and
    every name it absorbs is judged by that type. `order-id` is an identifier but no `json_name`, which
    adds `@` and `$` and not `-`, so the composition is refused at schema load.
    """
  meta: "meta.tn"
  import: ["core.tn"]
  error: {
    category: resolver
  }
}
