!!id:"https://tson.io/test-suite/class2/schema/invalid/a-parameter-deciding-whether-a-field-is-optional-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10"
  description: """
    `B` decides whether `v` may be missing, so the family base cannot say. A parameter is a type, and stands only at
    a field's type or as an argument of an application there or in a parent; `optional` is none of them.
    """
  error: {
    category: resolver
  }
}
