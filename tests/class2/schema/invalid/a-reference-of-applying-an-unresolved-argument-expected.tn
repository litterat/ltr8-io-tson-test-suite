!!id:"https://tson.io/test-suite/class2/schema/invalid/a-reference-of-applying-an-unresolved-argument-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §5.10 (inline types, proposed for Revision 40)"
  description: """
    A reference's `of` holds a name, never an application, so `box<nope>` there is refused whatever its arguments:
    it would be declared first and named. Its argument is no better, `nope` naming nothing in scope.
    """
  error: {
    category: resolver
  }
}
