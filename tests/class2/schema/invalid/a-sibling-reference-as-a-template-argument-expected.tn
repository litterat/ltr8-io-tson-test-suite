!!id:"https://tson.io/test-suite/class2/schema/invalid/a-sibling-reference-as-a-template-argument-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2, [TSON-SCHEMA] §5.10"
  description: """
    A sibling reference stands only at a record field's type. In sugar it parses wherever a reference does, written
    with the whitespace its `!` needs, and desugaring refuses it anywhere else: `box< kind! >` would need an
    application chosen per value, a template family that is not part of the language, so the argument is refused even
    though `cell` declares `kind`.
    """
  error: {
    category: resolver
  }
}
