!!id:"https://tson.io/test-suite/class2/schema/invalid/a-bare-group-of-one-all-marked-option-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.11"
  description: "A bare group of one option whose members are all marked is at least one of them, which is spelled `( a: text | b: text )+`; the grammar refuses the second spelling."
  meta: "meta.tn"
  import: ["core.tn"]
  error: {
    category: resolver
  }
}
