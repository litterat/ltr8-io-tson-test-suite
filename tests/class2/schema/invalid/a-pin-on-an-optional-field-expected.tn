!!id:"https://tson.io/test-suite/class2/schema/invalid/a-pin-on-an-optional-field-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2"
  description: "A pin names the only value a field admits, and `_` is not it: `type? = value` would admit `_` beside the pin, so a pin on an optional field is refused. `type = value` is the pin that omission supplies, and `type? = _` pins the field to absence."
  meta: "meta.tn"
  import: ["core.tn"]
  error: {
    category: resolver
  }
}
