!!id:"https://tson.io/test-suite/class2/schema/invalid/a-sibling-reference-as-an-alias-target-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2, [TSON-SCHEMA] §8.3"
  description: """
    A sibling reference stands only at a record field's type. In sugar it parses wherever a reference does, written
    with the whitespace its `!` needs, and desugaring refuses it anywhere else: `x => kind!` is an alias whose target
    is no record field's type, and an entry has no siblings, so it is refused.
    """
  error: {
    category: resolver
  }
}
