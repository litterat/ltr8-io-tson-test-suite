!!id:"https://tson.io/test-suite/class2/schema/invalid/a-name-type-pinned-to-a-non-member-is-refused-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §7.4, [TSON-SCHEMA] §5.2"
  description: """
    The kernel types `enum_type.name_type` `identifier_kind`, the names of the types built with
    `identifier_type`, and a constructor pinning the slot pins a value of that kind: a fixed value is a
    value of its field's type. `phrase` is built with `text_type`, so it is no member, and the meta layer
    declaring `phrase_enum` fails to load where the pin is written -- not at the first schema that applies
    the constructor.
    """
  error: {
    category: resolver
  }
}
