!!id:"https://tson.io/test-suite/class2/schema/invalid/a-parameter-at-a-fields-default-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10"
  description: """
    A field's value is never a parameter. `N` stands at `attempts`'s default, so the declaration is refused, naming
    the slot; a default that differs per application is restated where the application is declared, `retry5 =>
    retry<text> & { attempts?: ~ 5 }`.
    """
  error: {
    category: resolver
  }
}
