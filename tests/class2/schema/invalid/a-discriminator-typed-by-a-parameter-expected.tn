!!id:"https://tson.io/test-suite/class2/schema/invalid/a-discriminator-typed-by-a-parameter-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10"
  description: """
    A selector, like a literal, needs a type closed in every application, so the discriminator's type cannot vary
    per application. A pin is written by each member, never supplied by an argument.
    """
  error: {
    category: resolver
  }
}
