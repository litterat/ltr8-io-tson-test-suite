!!id:"https://tson.io/test-suite/class2/schema/invalid/a-parameter-at-a-size-bound-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §5.3"
  description: """
    A size bound is a count, and a parameter is a type: `[text; N]` puts `N` at the array's `min_items` and
    `max_items`, so the declaration is refused, naming the slot. A size is written as a number where the form is
    written.
    """
  error: {
    category: resolver
  }
}
