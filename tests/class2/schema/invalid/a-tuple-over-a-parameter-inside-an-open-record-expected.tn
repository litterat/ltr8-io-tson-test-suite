!!id:"https://tson.io/test-suite/class2/schema/invalid/a-tuple-over-a-parameter-inside-an-open-record-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §5.3"
  description: """
    Inside an open record a form over a parameter is admitted only where it is a reference, and a tuple's positions
    are a list of records, not reference fields: `[T, text]` is no reference, and the declaration is refused, naming
    the form.
    """
  error: {
    category: resolver
  }
}
