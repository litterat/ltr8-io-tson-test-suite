!!id:"https://tson.io/test-suite/class2/schema/invalid/a-template-parameter-shadowing-a-schema-type-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10"
  description: """
    A parameter that shadows a schema type is a resolver error: inside an open record a reference's name is looked up
    in the record's `parameters` before the namespace, so the type `T` would be unreachable there, and `ts` is
    refused at its declaration.
    """
  error: {
    category: resolver
  }
}
