!!id:"https://tson.io/test-suite/class2/schema/invalid/a-refinement-moving-an-int32-exclusive-min-outward-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.7"
  description: """
    A lower bound may only rise under refinement. `wider_count` lowers its source's `exclusive_min` from
    0 to -10, admitting values its source refuses, so the schema fails to load.
    """
  error: {
    category: resolver
  }
}
