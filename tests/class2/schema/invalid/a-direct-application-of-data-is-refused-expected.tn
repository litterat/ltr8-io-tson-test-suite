!!id:"https://tson.io/test-suite/class2/schema/invalid/a-direct-application-of-data-is-refused-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.1, [TSON-SCHEMA] §5.2"
  description: """
    `data` is a base kind, and abstract (SPEC-FEEDBACK.md #15): it has no instances of its own, so a direct
    application of it is refused as any abstract record's is. Nothing in scope composes `data`, so the diagnostic
    says that no constructor does rather than naming an empty list.
    """
  meta: "meta.tn"
  import: ["core.tn"]
  error: {
    category: resolver
  }
}
