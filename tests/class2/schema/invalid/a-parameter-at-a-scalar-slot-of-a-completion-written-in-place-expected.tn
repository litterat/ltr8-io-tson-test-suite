!!id:"https://tson.io/test-suite/class2/schema/invalid/a-parameter-at-a-scalar-slot-of-a-completion-written-in-place-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §5.5"
  description: """
    A completion written in place is the construction of the incomplete entry's constructor, so its slots are that
    constructor's: `max_items` is `array`'s count, a slot that holds no type, and `N` standing there is refused at
    the declaration as it is at a size bound anywhere else.
    """
  error: {
    category: resolver
  }
}
