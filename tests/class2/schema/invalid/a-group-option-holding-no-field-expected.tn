!!id:"https://tson.io/test-suite/class2/schema/invalid/a-group-option-holding-no-field-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.11, [TSON-SCHEMA] §8.1"
  description: """
    An option is chosen when any of its members is present, so an option holding no field can never be
    chosen: `field_group.members` is `[[field_name; 1..]; 1..]`, and an empty option is not valid data for it.
    """
  meta: "meta.tn"
  import: ["core.tn"]
  error: {
    category: resolver
  }
}
