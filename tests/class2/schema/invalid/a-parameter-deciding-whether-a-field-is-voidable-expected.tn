!!id:"https://tson.io/test-suite/class2/schema/invalid/a-parameter-deciding-whether-a-field-is-voidable-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10"
  description: """
    `V` decides whether `v` may be void, which an open record states as written for every application. A parameter
    is a type, and stands only at a field's type or as an argument of an application there or in a parent.
    """
  error: {
    category: resolver
  }
}
