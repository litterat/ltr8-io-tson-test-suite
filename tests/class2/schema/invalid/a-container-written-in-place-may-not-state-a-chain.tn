!!id:"https://tson.io/test-suite/class2/schema/invalid/a-container-written-in-place-may-not-state-a-chain.tn"
!!import:"https://tson.io/2026/40/m/meta.tn"
!!import:"https://tson.io/2026/40/m/core.tn"
!schema {
  base  => { y: int32 }
  order => !meta.record { fields: {
    tags => !meta.record_field { type: { of: !meta.array {
      element_type: text
      chain: { supertypes: [base] }
    } } }
  } }
}
