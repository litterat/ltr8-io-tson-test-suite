!!id:"https://tson.io/test-suite/class2/schema/invalid/a-plain-supertype-does-not-compose-with-a-translations-record.tn"
!!import:"https://tson.io/2026/39/m/meta.tn"
!!import:"https://tson.io/2026/39/m/core.tn"
!schema {
  json_name => !identifier_type { start_add: "@$" }
  json_record => !record { name_type: json_name  extension: ABSTRACT  fields: {} }
  address => { city: text }
  node => json_record & address & { "@id": text }
}
