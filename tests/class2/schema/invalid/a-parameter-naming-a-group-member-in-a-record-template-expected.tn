!!id:"https://tson.io/test-suite/class2/schema/invalid/a-parameter-naming-a-group-member-in-a-record-template-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10"
  description: """
    A group member is a field name, so `A` names a field and the family base cannot list it. A record template's
    parameters stand only in a field's type, a field's default or fixed value, or an argument of an application.
    """
  meta: "meta.tn"
  import: ["core.tn"]
  error: {
    category: resolver
  }
}
