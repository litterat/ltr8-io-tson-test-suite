!!id:"https://tson.io/test-suite/class2/schema/invalid/construction-sugar-argument-is-a-reference-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.3 (construction sugar, proposed for Revision 40)"
  description: """
    Every argument of construction sugar lands in a field typed by a reference naming types, so it is a type's
    name. `meta.array<3>` gives `element_type` a number, which names no type, and is refused.
    """
  error: {
    category: resolver
  }
}
