!!id:"https://tson.io/test-suite/class2/schema/invalid/a-template-may-not-compose-a-final-record-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2, [TSON-SCHEMA] §5.10"
  description: """
    `final` admits no subtype, and a template composing a final record writes one into every application: an
    application's IS-A edges are its template's written parents', so each application of `t` would be IS-A `c`. The
    refusal is the declaration's, where `t` names `c`, not the first application's -- there is none here.
    """
  error: {
    category: resolver
  }
}
