!!id:"https://tson.io/test-suite/class2/schema/invalid/a-template-bound-naming-a-constructor-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.1, §5.10"
  description: "A bound names a type, which every argument must IS-A. `text_type` resolves, and is a constructor, not a type (§4.1), so no type argument could satisfy the bound, and the declaration is refused."
  error: {
    category: resolver
  }
}
