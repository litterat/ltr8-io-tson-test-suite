!!id:"https://tson.io/test-suite/class2/schema/invalid/a-quoted-token-is-no-field-type-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.12, [TSON-SCHEMA] §12.1"
  description: """
    A field's type is a position of the schema grammar, whose `type-ref` is an unquoted name: `"text"` is no
    `type-expr`, so the field does not parse. A quoted token is a reference only at a position typed by one, in data
    or in a body read as data.
    """
  error: {
    category: resolver
  }
}
