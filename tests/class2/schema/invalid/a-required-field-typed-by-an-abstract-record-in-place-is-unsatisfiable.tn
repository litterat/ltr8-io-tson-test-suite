!!id:"https://tson.io/test-suite/class2/schema/invalid/a-required-field-typed-by-an-abstract-record-in-place-is-unsatisfiable.tn"
!!import:"https://tson.io/2026/40/m/meta.tn"
!!import:"https://tson.io/2026/40/m/core.tn"
!schema {
  order => !meta.record { fields: {
    at => !meta.record_field { type: { of: !meta.record {
      fields: { x => !meta.record_field { type: int32 } }
      extension: ABSTRACT
    } } }
  } }
}
