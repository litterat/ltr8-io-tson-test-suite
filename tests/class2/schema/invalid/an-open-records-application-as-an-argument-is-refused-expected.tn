!!id:"https://tson.io/test-suite/class2/schema/invalid/an-open-records-application-as-an-argument-is-refused-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.3, [TSON-SCHEMA] §5.10 (inline types, proposed for Revision 40)"
  description: """
    An argument of an open record's application is a name or a parameter, so an application of another open record
    passed as one is refused: `pair<box<text> int32>` is written `pair<text_box int32>` over the declaration
    `text_box => box<text>`.
    """
  error: {
    category: resolver
  }
}
