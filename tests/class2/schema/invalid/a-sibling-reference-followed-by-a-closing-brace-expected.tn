!!id:"https://tson.io/test-suite/class2/schema/invalid/a-sibling-reference-followed-by-a-closing-brace-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-DATA] §7.5, [TSON-SCHEMA] §12.3"
  description: """
    A postfix `!` is followed by whitespace even where a sibling reference stands: at a record field's type, the one
    place it may, `kind!}` does not parse. A sibling reference ends a field's type, so in a well-formed record
    whitespace always follows it.
    """
  error: {
    category: resolver
  }
}
