!!id:"https://tson.io/test-suite/class2/schema/invalid/a-quoted-token-is-no-type-argument-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §12.1"
  description: """
    An argument is a type, written as a reference: a name or an application. A quoted token is never a reference, so
    `box<"dog">` is no application and the schema does not load.
    """
  error: {
    category: resolver
  }
}
