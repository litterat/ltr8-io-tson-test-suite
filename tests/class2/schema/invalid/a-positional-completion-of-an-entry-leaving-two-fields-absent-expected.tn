!!id:"https://tson.io/test-suite/class2/schema/invalid/a-positional-completion-of-an-entry-leaving-two-fields-absent-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §5.6"
  description: """
    The positional form completes only an entry leaving exactly one required field absent; `open` leaves
    `key_type` and `value_type`, so `!open text` says nothing about which one `text` is.
    """
  error: {
    category: resolver
  }
}
