!!id:"https://tson.io/test-suite/class2/schema/invalid/a-sibling-reference-naming-no-field-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2"
  description: """
    A sibling reference names a field of the same record and never a schema entry: `kind` is declared at the root, but
    `cell` has no field `kind`, so `kind!` names nothing.
    """
  error: {
    category: resolver
  }
}
