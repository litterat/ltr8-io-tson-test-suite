!!id:"https://tson.io/test-suite/class2/schema/valid/a-refinement-of-a-map-type-restating-its-type-slots-through-aliases-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.7 (refinement of a collection type, proposed for Revision 40), [TSON-SCHEMA] §8.3"
  description: """
    A map's `key_type` and `value_type` are fixed at construction and each restated as the type it holds: `word`
    is `text` and `tally` is `int32` under other names, so both slots are restated and `small` IS-A `index`. The
    resolved value states each slot as the source wrote it.
    """
  valid: {
    resolved: """
      !schema {
        word  => !meta.alias { target: text }
        tally => !meta.alias { target: int32 }
        index => !meta.map { chain: { subtypes: [small] }  key_type: text  value_type: int32 }
        small => !meta.map { chain: { supertypes: [index] }  key_type: text  value_type: int32  max_items: 3 }
      }
      """
  }
}
