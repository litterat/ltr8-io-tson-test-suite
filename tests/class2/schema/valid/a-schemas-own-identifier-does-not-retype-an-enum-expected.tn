!!id:"https://tson.io/test-suite/class2/schema/valid/a-schemas-own-identifier-does-not-retype-an-enum-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §7.4"
  description: """
    The `identifier` that `enum` pins was written in the governing meta and names the kernel's
    identifier there. A schema's own `identifier`, here one admitting only lowercase names, is a
    different type in a different namespace, so it does not retype the enum: `LOUD` and `QUIET` are
    names, and the enum loads.
    """
  meta: "meta.tn"
  import: ["core.tn"]
  valid: {
    resolved: """
      !schema {
        identifier => !identifier_type { pattern: "[a-z]+" }

        shout => !enum { members: [LOUD QUIET] }
      }
      """
  }
}
