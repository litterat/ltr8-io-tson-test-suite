!!id:"https://tson.io/test-suite/class2/schema/valid/a-constructor-application-is-a-direct-instance-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.1, [TSON-SCHEMA] §5.5"
  description: """
    The base kinds are abstract, and the constructors beneath them are not: `!record` and `!integer_type` have direct
    instances, each an entry whose value is the construction, with an empty chain -- construction transfers kind, not
    IS-A.
    """
  meta: "meta.tn"
  import: ["core.tn"]
  valid: {
    resolved: """
      !schema {
        pair => !record { fields: {
          a => !record_field { type: text }
          b => !record_field { type: int32 }
        } }

        count => !integer_type { min: 0 }
      }
      """
  }
}
