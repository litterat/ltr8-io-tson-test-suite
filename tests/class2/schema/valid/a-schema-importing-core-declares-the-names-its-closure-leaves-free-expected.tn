!!id:"https://tson.io/test-suite/class2/schema/valid/a-schema-importing-core-declares-the-names-its-closure-leaves-free-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §2.2.3, §9"
  description: """
    A local declaration may not reuse a name its import closure binds, so every name core declares, and every
    name of meta.tn and the meta-kernel core imports, is one no schema importing core may declare. Core keeps to
    the types a schema cannot do without, and the names a schema would use for its own types are left free: a
    sign bound, a length bound and a documentation annotation are each declared here, in a schema importing
    core.
    """
  meta: "meta.tn"
  import: ["core.tn"]
  valid: {
    resolved: """
      !schema {
        positive_integer => !integer_type { chain: { supertypes: [integer] }  min: 1 }

        non_empty_text => !text_type { chain: { supertypes: [text] }  min_length: 1 }

        documentation => @annotation !reference { target: text }
      }
      """
  }
}
