!!id:"https://tson.io/test-suite/class2/schema/valid/a-schema-importing-core-declares-the-names-its-closure-leaves-free-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §2.2.3, §9 (the kernel under meta, proposed)"
  description: """
    A local declaration may not reuse a name its import closure binds. The kernel's declarations are members of
    one root entry, `meta`, so a schema importing core reserves `meta` and core's own root names, and the names
    a schema would use for its own types are left free: a sign bound, a length bound, a documentation
    annotation, and `record`, `bounded`, `template` and `namespace`, each a kernel name only by its path
    (`meta.record`, `meta.bounded`), are each declared here, in a schema importing core.
    """
  valid: {
    resolved: """
      !schema {
        positive_integer => !meta.integer_type { chain: { supertypes: [meta.integer] }  min: 1 }

        non_empty_text => !meta.text_type { chain: { supertypes: [meta.text] }  min_length: 1 }

        documentation => @annotation !meta.alias { target: text }

        record => !meta.record { fields: {
          id      => !meta.record_field { type: uuid }
          bounded => !meta.record_field { type: boolean }
        } }

        bounded => !meta.integer_type { chain: { supertypes: [meta.integer] }  min: 0  max: 9 }

        template => !meta.record { fields: { body => !meta.record_field { type: text } } }

        namespace => !meta.array { element_type: text }
      }
      """
  }
}
