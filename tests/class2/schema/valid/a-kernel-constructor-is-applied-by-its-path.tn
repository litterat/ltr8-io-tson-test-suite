!!id:"https://tson.io/test-suite/class2/schema/valid/a-kernel-constructor-is-applied-by-its-path.tn"
!!import:"https://tson.io/2026/39/m/meta.tn"
@doc:"A schema importing the kernel alone names its constructors by path and its types bare."
!schema {
  @doc:"A percentage."
  percent => !numeric.integer_type { min: 0  max: 100 }
  code    => !unicode.text_type { length: 2 }
  reading => { at: percent  label: text  ok: boolean }
}
