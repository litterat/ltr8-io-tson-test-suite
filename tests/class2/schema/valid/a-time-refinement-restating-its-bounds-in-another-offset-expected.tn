!!id:"https://tson.io/test-suite/class2/schema/valid/a-time-refinement-restating-its-bounds-in-another-offset-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §5.7"
  description: """
    The offset of a `time` is a spelling: the value is the time of day in UTC, so `08:00:00Z` is
    `09:00:00+01:00` and `17:00:00Z` is `18:00:00+01:00`. `office_hours_utc` restates both of its source's
    bounds, which an ordered bound may do, so the refinement resolves. Each bound is kept as written.
    """
  valid: {
    resolved: """
      !schema {
        office_hours => !temporal.time_type { chain: { supertypes: [time]  subtypes: [office_hours_utc] }  min: "09:00:00+01:00"  exclusive_max: "18:00:00+01:00" }

        office_hours_utc => !temporal.time_type { chain: { supertypes: [office_hours time] }  min: "08:00:00Z"  exclusive_max: "17:00:00Z" }
      }
      """
  }
}
