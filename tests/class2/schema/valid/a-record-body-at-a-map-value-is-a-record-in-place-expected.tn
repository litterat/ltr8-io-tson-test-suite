!!id:"https://tson.io/test-suite/class2/schema/valid/a-record-body-at-a-map-value-is-a-record-in-place-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2, [TSON-SCHEMA] §8.2 (a record written in place, proposed for Revision 40)"
  description: """
    A record body at a map's value is written in place: the declaration's own body is the map construction, whose
    `value_type` holds the record in its wrapper. The brace after `=>` dispatches as a declaration's body does.
    """
  valid: {
    resolved: """
      !schema {
        index => !meta.map { key_type: text  value_type: { of: !meta.record { fields: { n => !meta.record_field { type: int32 } } } } }
      }
      """
  }
}
