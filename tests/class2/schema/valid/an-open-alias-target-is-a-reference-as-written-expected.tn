!!id:"https://tson.io/test-suite/class2/schema/valid/an-open-alias-target-is-a-reference-as-written-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §8.1"
  description: """
    A partial application is an open alias, and its target is the reference as written: an application is
    a reference with an argument list, data grammar written unquoted in its canonical text, with no
    whitespace and one space between arguments. `uuid_pair` holds `!alias { target: pair<uuid B> }`; the
    parameter `B` stands as its name, and `uuid` is the argument the alias already binds. Applied, the argument
    is substituted into the target's argument list and the alias composes: `up` names the expansion of
    `pair<uuid int32>`.
    """
  valid: {
    resolved: """
      !schema {
        pair => !meta.record {
          parameters: [
            !meta.template_param { name: A  type: meta.type_kind }
            !meta.template_param { name: B  type: meta.type_kind }
          ]
          fields: {
            first  => !meta.record_field { type: A }
            second => !meta.record_field { type: B }
          }
        }

        uuid_pair => !meta.template {
          parameters: [ !meta.template_param { name: B  type: meta.type_kind } ]
          template: "!meta.alias { target: pair<uuid B> }"
        }

        up => !meta.alias { target: record_first_uuid_second_int32_xxhash }

        @meta.synthetic record_first_uuid_second_int32_xxhash => !meta.record { fields: {
          first  => !meta.record_field { type: uuid }
          second => !meta.record_field { type: int32 }
        } }
      }
      """
  }
}
