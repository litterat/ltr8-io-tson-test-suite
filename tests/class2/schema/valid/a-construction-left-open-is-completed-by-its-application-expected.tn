!!id:"https://tson.io/test-suite/class2/schema/valid/a-construction-left-open-is-completed-by-its-application-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5"
  description: """
    `!meta.array ^ { min_items: 1 }` leaves `element_type`, a required field of `meta.array`, absent, so
    `nonempty` is an incomplete entry: no type, and not in the resolved form, which holds complete entries only.
    `nonempty<text>` completes it, and the completion is the plain construction `!meta.array { element_type: text
    min_items: 1 }`, carrying no chain, exactly as `written` spells it.
    """
  valid: {
    resolved: """
      !schema {
        @meta.completion:{ of: [nonempty] }
        tags    => !meta.array { element_type: text  min_items: 1 }
        written => !meta.array { element_type: text  min_items: 1 }
      }
      """
  }
}
