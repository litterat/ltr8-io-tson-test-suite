!!id:"https://tson.io/test-suite/class2/schema/valid/a-record-application-nothing-declares-is-its-expansion-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §8.2"
  description: "An application of a record template, written at a use site and declared nowhere, is its expansion: a closed synthetic record keyed on its content, @synthetic at its key, with no instantiation entry and no @application. box<int32> and crate<int32>, over two templates with one field list, are one entry."
  meta: "meta.tn"
  import: ["core.tn"]
  valid: {
    resolved: """
      !schema {
        box => !record {
          fields: { v => !record_field { type: T } }
          parameters: [ !template_param { name: T  type: type_ref } ]
        }

        crate => !record {
          fields: { v => !record_field { type: T } }
          parameters: [ !template_param { name: T  type: type_ref } ]
        }

        holder => !record { fields: {
          a => !record_field { type: record_v_int32_xxhash }
          b => !record_field { type: record_v_int32_xxhash }
        } }

        @synthetic record_v_int32_xxhash => !record { fields: { v => !record_field { type: int32 } } }
      }
      """
  }
}
