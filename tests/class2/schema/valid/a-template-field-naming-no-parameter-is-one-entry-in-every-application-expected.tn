!!id:"https://tson.io/test-suite/class2/schema/valid/a-template-field-naming-no-parameter-is-one-entry-in-every-application-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §8.2"
  description: """
    A field type in a record template that names none of its parameters means the same in every application, so it is
    closed in the template and names the entry every application names: `box<text>` is its expansion in `pet` as in
    `cat`, one minted record named for its content. `cat` is not IS-A `pet`: a template is no type.
    """
  valid: {
    resolved: """
      !schema {
        box => !meta.record_template {
          fields: { v => !meta.record_template_field { type_param: T } }
          parameters: [ !meta.template_param { name: T } ]
        }

        pet => !meta.record_template {
          fields: {
            tag  => !meta.record_template_field { type: record_v_text_xxhash }
            name => !meta.record_template_field { type_param: V }
          }
          parameters: [ !meta.template_param { name: V } ]
        }

        @meta.application:pet<text>
        cat => !meta.record {
          fields: {
            tag  => !meta.record_field { type: record_v_text_xxhash }
            name => !meta.record_field { type: text }
          }
        }

        @meta.synthetic record_v_text_xxhash => !meta.record { fields: { v => !meta.record_field { type: text } } }
      }
      """
  }
}
