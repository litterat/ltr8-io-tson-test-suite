!!id:"https://tson.io/test-suite/class2/schema/valid/a-dependent-field-restated-as-itself-may-become-required-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2, [TSON-SCHEMA] §5.7"
  description: """
    A dependent field may be restated as itself, and the restatement may move its omission along §5.7's order as any
    field's may: `strict` makes `v` required, nothing to required, and its type stays the dependent type on `kind`.
    It has no voidable mark to move, a dependent field never being voidable.
    """
  valid: {
    resolved: """
      !schema {
        cell => !meta.record { chain: { subtypes: [strict] }  fields: {
          kind => !meta.record_field { type: meta.type_ref }
          v    => !meta.record_field { type: { of: !meta.dependent { on: kind } }  optional: true }
        } }

        strict => !meta.record { chain: { supertypes: [cell] }  fields: {
          kind => !meta.record_field { type: meta.type_ref }
          v    => !meta.record_field { type: { of: !meta.dependent { on: kind } } }
        } }
      }
      """
  }
}
