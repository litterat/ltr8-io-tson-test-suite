!!id:"https://tson.io/test-suite/class2/schema/valid/a-completion-of-an-imported-incomplete-entry-names-it-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §8.1, [TSON-SCHEMA] §5.5, [TSON-SCHEMA] §2.2.3"
  description: """
    An imported incomplete entry is named in `@meta.completion` by its name in the one namespace, as it is
    written in the importing schema: `ne<uuid>` lists the fixture's `nonempty` past the local alias, and `few<text>`
    lists the local `few` and then `nonempty`.
    """
  valid: {
    resolved: """
      !schema {
        @meta.completion:{ of: [nonempty] }
        ids  => !meta.array { element_type: uuid  min_items: 1 }
        @meta.completion:{ of: [few nonempty] }
        tags => !meta.array { element_type: text  min_items: 1  max_items: 9 }
      }
      """
  }
}
