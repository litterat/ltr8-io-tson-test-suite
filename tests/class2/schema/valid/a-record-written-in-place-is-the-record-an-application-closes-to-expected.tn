!!id:"https://tson.io/test-suite/class2/schema/valid/a-record-written-in-place-is-the-record-an-application-closes-to-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2, [TSON-SCHEMA] §5.10, [TSON-SCHEMA] §8.2 (a record written in place, proposed for Revision 40)"
  description: """
    A record body written at a slot and an application of an open record closing there are one form: `at` and `closed`
    hold equal records in place, one type.
    """
  valid: {
    resolved: """
      !schema {
        xy => !meta.record {
          parameters: [ !meta.param { name: T } ]
          fields: { x => !meta.record_field { type: T }  y => !meta.record_field { type: T } }
        }

        order => !meta.record { fields: {
          at     => !meta.record_field { type: { of: !meta.record { fields: { x => !meta.record_field { type: int32 }  y => !meta.record_field { type: int32 } } } } }
          closed => !meta.record_field { type: { of: !meta.record { fields: { x => !meta.record_field { type: int32 }  y => !meta.record_field { type: int32 } } } } }
        } }
      }
      """
  }
}
