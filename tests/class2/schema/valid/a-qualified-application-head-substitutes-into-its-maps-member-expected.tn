!!id:"https://tson.io/test-suite/class2/schema/valid/a-qualified-application-head-substitutes-into-its-maps-member-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §5.3, [TSON-SCHEMA] §5.10 (qualified names, proposed)"
  description: """
    An application's head and a reference's `of` are qualified names like any other: `geo.box<text>` substitutes into
    the open record `box` of `geo`, and `meta.ref<geo.base>` constructs `!meta.ref { of: geo.base }`. The declaration
    closing the application is its record wherever it is declared, and its `@meta.application` states the head by its
    path; written at a field, `geo.box<int32>` closes in place to its record, with no name. The construction carries
    no `@meta.application`.
    """
  valid: {
    resolved: """
      !schema {
        geo => !meta.schema {
          box => !meta.record {
            parameters: [ !meta.param { name: T } ]
            fields: { item => !meta.record_field { type: T } }
          }

          base => !meta.record { fields: { id => !meta.record_field { type: text } } }
        }

        @meta.application:geo.box<text>
        boxed => !meta.record {
          fields: { item => !meta.record_field { type: text } }
        }

        held => !meta.record { fields: {
          b => !meta.record_field { type: { of: !meta.record { fields: { item => !meta.record_field { type: int32 } } } } }
        } }

        bases => !meta.ref { of: geo.base }
      }
      """
  }
}
