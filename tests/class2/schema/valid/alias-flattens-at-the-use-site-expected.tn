!!id:"https://tson.io/test-suite/class2/schema/valid/alias-flattens-at-the-use-site-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §8.3"
  description: "A type position naming a REFERENCE entry is rewritten to the end of its chain and keeps the name the author wrote as @alias, which is what makes an instantiation identity a single-level comparison."
  meta: "meta.tn"
  import: ["core.tn"]
  valid: {
    resolved: """
      !schema {
        user_id => !type_definition {
          kind: REFERENCE
          source: text
          body: !reference { target: text }
        }

        user => !type_definition {
          kind: PRODUCT
          body: !record { fields: [
            !record_field { name: key  type: @alias:user_id text }
          ] }
        }
      }
      """
  }
}
