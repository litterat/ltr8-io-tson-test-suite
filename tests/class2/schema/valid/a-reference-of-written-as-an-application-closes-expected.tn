!!id:"https://tson.io/test-suite/class2/schema/valid/a-reference-of-written-as-an-application-closes-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §5.3, [TSON-SCHEMA] §5.10, [TSON-SCHEMA] §8.2"
  description: """
    A reference's `of` is typed `meta.type_ref`, a type position, so an application written there closes to the
    entry it denotes as one anywhere else does: `box<text>` is its expansion, the record `{ v: text }`, and `of`
    names it. `meta.ref<box<text>>` constructs `!meta.ref { of: box<text> }`, its argument closed the same way, so
    the two spellings resolve to one reference over one entry; a construction substitutes nothing and carries no
    `@meta.application`.
    """
  valid: {
    resolved: """
      !schema {
        box => !meta.record {
          parameters: [ !meta.param { name: T } ]
          fields: { v => !meta.record_field { type: T } }
        }

        written => !meta.reference_type { of: record_v_text_xxhash  allow_sibling: false }

        applied => !meta.ref { of: record_v_text_xxhash }

        @meta.synthetic record_v_text_xxhash => !meta.record { fields: { v => !meta.record_field { type: text } } }
      }
      """
  }
}
