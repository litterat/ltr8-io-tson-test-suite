!!id:"https://tson.io/test-suite/class2/schema/valid/an-import-free-schema-sees-only-its-own-names-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §2.2.3, [TSON-SCHEMA] §8.1"
  description: """
    A schema need import nothing: its root's `!schema` tag classifies it, so a map of declarations with no
    header is unambiguous, and with no imports its namespace is its own entries alone. `a.b` is typed by `b`,
    a sibling, and `{}` declares the zero-field record, `!record { fields: {} }`. The kernel's constructors
    build both entries without being names this schema can see.
    """
  valid: {
    resolved: """
      !schema {
        a => !record { fields: {
          b => !record_field { type: b }
        } }

        b => !record { fields: {} }
      }
      """
  }
}
