!!id:"https://tson.io/test-suite/class2/schema/valid/a-type-carries-its-complete-chain-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.8"
  description: """
    A type carries its own IS-A chain, and in a closed body the chain is complete: `employee` composes `person` and so
    is IS-A `named` too, each a bare name. `subtypes` is the inverse over this map, so `named` lists both of the records
    that are IS-A it. An entry is its value -- there is no wrapper around the body to hold the chain.
    """
  valid: {
    resolved: """
      !schema {
        named => !meta.record { chain: { subtypes: [employee person] }  fields: {
          name => !meta.record_field { type: text }
        } }

        person => !meta.record { chain: { supertypes: [named]  subtypes: [employee] }  fields: {
          name => !meta.record_field { type: text }
          age  => !meta.record_field { type: int32 }
        } }

        employee => !meta.record { chain: { supertypes: [named person] }  fields: {
          name     => !meta.record_field { type: text }
          age      => !meta.record_field { type: int32 }
          staff_id => !meta.record_field { type: text }
        } }
      }
      """
  }
}
