!!id:"https://tson.io/test-suite/class2/schema/valid/a-member-pins-a-field-where-the-application-is-declared-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.7, [TSON-SCHEMA] §5.10"
  description: """
    A value that differs per application is written where the application is declared, a field's value never being a
    parameter: `created` composes `response<order>` and restates `status` FIXED to `201`, as a hand-written member
    pins a field it inherits. The operand adds no entry, and `created` is not IS-A `response`: a template is no type,
    and `response` writes no parent for an application to inherit.
    """
  valid: {
    resolved: """
      !schema {
        order => !meta.record {
          fields: { id => !meta.record_field { type: text } }
        }

        response => !meta.record {
          fields: {
            status => !meta.record_field { type: int32 }
            body   => !meta.record_field { type: T }
          }
          parameters: [ !meta.param { name: T } ]
        }

        created => !meta.record {
          fields: {
            status => !meta.record_field { type: int32  optional: true  role: FIXED  value: 201 }
            body   => !meta.record_field { type: order }
          }
        }
      }
      """
  }
}
