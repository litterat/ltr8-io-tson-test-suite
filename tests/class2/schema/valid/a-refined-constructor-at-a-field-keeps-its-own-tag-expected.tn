!!id:"https://tson.io/test-suite/class2/schema/valid/a-refined-constructor-at-a-field-keeps-its-own-tag-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §5.3 (inline types, proposed for Revision 40)"
  description: """
    An application of a constructor at a field constructs it in place, and a constructor refining a structural one
    keeps its own tag there: `set<text>` is `!meta.set_type { element_type: text }`, never the `!meta.array` it
    refines, and `meta.ref<order>` is `!meta.ref { of: order }`. Each is held in the wrapper.
    """
  valid: {
    resolved: """
      !schema {
        order => !meta.record { fields: { id => !meta.record_field { type: text } } }

        post => !meta.record { fields: {
          labels => !meta.record_field { type: { of: !meta.set_type { element_type: text } } }
          target => !meta.record_field { type: { of: !meta.ref { of: order } } }
        } }
      }
      """
  }
}
