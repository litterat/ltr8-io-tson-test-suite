!!id:"https://tson.io/test-suite/class2/schema/valid/a-positional-field-written-with-a-parameter-is-typed-by-it-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.6, [TSON-SCHEMA] §5.10"
  description: """
    A field written positionally in an open record's explicit spelling, `<T> !meta.record { fields: { item => T } }`,
    is `item => { type: T }`: the parameter is the field's type, written as its name, as in the sugar `<T> { item: T
    }`. No label says which a `type` is; the record's `parameters` say it.
    """
  valid: {
    resolved: """
      !schema {
        box => !meta.record {
          fields: { item => !meta.record_field { type: T } }
          parameters: [ !meta.param { name: T } ]
        }
      }
      """
  }
}
