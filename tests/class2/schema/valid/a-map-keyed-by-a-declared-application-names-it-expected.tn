!!id:"https://tson.io/test-suite/class2/schema/valid/a-map-keyed-by-a-declared-application-names-it-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.3 (inline types, proposed for Revision 40)"
  description: """
    A map's key is a name, so a key over a constructed type is declared and named: `method_ref => meta.ref<method>`
    and `labels => set<text>` are entries, and `{method_ref => int32}` holds `key_type: method_ref`. The map itself
    is written in place at its field.
    """
  valid: {
    resolved: """
      !schema {
        method => !meta.record { fields: { name => !meta.record_field { type: text } } }

        method_ref => !meta.ref { of: method }

        labels => !meta.set_type { element_type: text }

        post => !meta.record { fields: {
          by_method => !meta.record_field { type: { of: !meta.map { key_type: method_ref  value_type: int32 } } }
          by_labels => !meta.record_field { type: { of: !meta.map { key_type: labels  value_type: int32 } } }
        } }
      }
      """
  }
}
