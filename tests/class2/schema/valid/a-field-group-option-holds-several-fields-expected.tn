!!id:"https://tson.io/test-suite/class2/schema/valid/a-field-group-option-holds-several-fields-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.11"
  description: "An option of a field group may hold several fields: `|` separates options, and a `?` on a member's name makes it optional once its option is chosen. Each member is an optional field of the record, and the group records its options in `members`, the marked members in `optional_members`, and whether it is optional. `+` is sugar for at least one of its members: the non-optional group of one option whose members are all optional within it."
  valid: {
    resolved: """
      !schema {
        fragment => !meta.record {
          fields: {
            include => !meta.record_field { type: text  optional: true }
            name    => !meta.record_field { type: text  optional: true }
            type    => !meta.record_field { type: text  optional: true }
          }
          groups: [
            !meta.field_group { members: [[include] [name type]]  optional_members: [name type] }
          ]
        }
        endpoint => !meta.record {
          fields: {
            host   => !meta.record_field { type: text   optional: true }
            port   => !meta.record_field { type: int32  optional: true }
            socket => !meta.record_field { type: text   optional: true }
          }
          groups: [
            !meta.field_group { members: [[host port] [socket]]  optional: true }
          ]
        }
        contact => !meta.record {
          fields: {
            email => !meta.record_field { type: text  optional: true }
            phone => !meta.record_field { type: text  optional: true }
          }
          groups: [
            !meta.field_group { members: [[email phone]]  optional_members: [email phone] }
          ]
        }
      }
      """
  }
}
