!!id:"https://tson.io/test-suite/class2/schema/valid/an-inherited-literal-spelled-like-a-parameter-stays-a-literal-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10"
  description: """
    A parameter stands at a field's type or as an argument, and a field's value is never one: `base` pins `kind` to
    the literal `T`, and `fam`, declaring a parameter spelled `T`, takes the field as it is -- a literal `value` --
    so every application of `fam` keeps `base`'s pin. Only `v`'s type, which `fam` writes, is the parameter.
    """
  valid: {
    resolved: """
      !schema {
        base => !meta.record {
          fields: { kind => !meta.record_field { type: text  optional: true  role: FIXED  value: T } }
        }

        fam => !meta.record {
          chain: { parents: [base]  supertypes: [base] }
          fields: {
            kind => !meta.record_field { type: text  optional: true  role: FIXED  value: T }
            v    => !meta.record_field { type: T }
          }
          parameters: [ !meta.param { name: T } ]
        }
      }
      """
  }
}
