!!id:"https://tson.io/test-suite/class2/schema/valid/an-inherited-literal-spelled-like-a-parameter-stays-a-literal-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10"
  description: """
    §5.10's shadowing rule classifies what a template writes, and nothing it absorbs: `base` pins `kind` to the
    literal `T`, and `fam`, declaring a parameter spelled `T`, takes the field as it is -- a `value`, not a
    `value_param` -- so every application of `fam` keeps `base`'s pin. Only `v`, which `fam` writes, names the
    parameter.
    """
  valid: {
    resolved: """
      !schema {
        base => !meta.record {
          chain: { subtypes: [fam] }
          fields: { kind => !meta.record_field { type: text  optional: true  role: FIXED  value: T } }
        }

        fam => !meta.record_template {
          chain: { parents: [base]  supertypes: [base] }
          fields: {
            kind => !meta.record_template_field { type: text  optional: true  role: FIXED  value: T }
            v    => !meta.record_template_field { type_param: T }
          }
          parameters: [ !meta.template_param { name: T  type: meta.type_ref } ]
        }
      }
      """
  }
}
