!!id:"https://tson.io/test-suite/class2/schema/valid/composition-flattens-fields-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.8"
  description: "Composition absorbs an operand's fields into the composed record and records the operand as a supertype; the resolved body states every field flat."
  valid: {
    resolved: """
      !schema {
        named => !record { chain: { subtypes: [person] }  fields: {
          name => !record_field { type: text }
        } }
      
        person => !record { chain: { supertypes: [named] }  fields: {
          name => !record_field { type: text }
          age  => !record_field { type: int32 }
        } }
      }
      """
  }
}
