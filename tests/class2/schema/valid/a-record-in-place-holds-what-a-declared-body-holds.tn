!!import:"https://tson.io/2026/40/m/meta.tn"
!!import:"https://tson.io/2026/40/m/core.tn"
!schema {
  setting => { at: {
    kind:   meta.type_ref
    value?: kind!
    note?:  text? ~ "none"
    level:  int32 = 3
    inner:  { deep: { leaf: text } }
    ( a: int32 | b: text )?
  } }
}
