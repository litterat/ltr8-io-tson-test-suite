{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §7.5"
  description: "A map and an array each state whether order is part of their value, through the kernel's `ordered` facet: a map is unordered unless it says otherwise and an array ordered, so a binding record names the facet only where it departs from that default."
  meta: "meta.tn"
  import: ["core.tn"]
  valid: {
    resolved: """
      !schema {
        steps => !type_definition {
          source: map
          body: !map { key_type: text  value_type: integer  ordered: true }
        }
        lookup => !type_definition {
          source: map
          body: !map { key_type: text  value_type: integer }
        }
        tags => !type_definition {
          source: array
          body: !array { element_type: text  ordered: false }
        }
      }
      """
  }
}
