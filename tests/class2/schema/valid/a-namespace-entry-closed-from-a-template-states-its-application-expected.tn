!!id:"https://tson.io/test-suite/class2/schema/valid/a-namespace-entry-closed-from-a-template-states-its-application-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §8.2"
  description: """
    An entry of any kind can be an instantiation, so the application it is the instantiation of sits on its key, as
    @meta.synthetic does: order_api closes orders<order> to an instance of the namespace type interface, which carries
    no chain, and its key states @meta.application. A namespace entry is no type, and the fact is about the entry.
    """
  valid: {
    resolved: """
      !schema {
        order => !meta.record { fields: {
          id => !meta.record_field { type: text }
        } }

        orders => !meta.template {
          parameters: [ !meta.template_param { name: T } ]
          template: "!interface { get => { response: T } }"
        }

        @meta.application:orders<order>
        order_api => !interface { get => { response: order } }
      }
      """
  }
}
