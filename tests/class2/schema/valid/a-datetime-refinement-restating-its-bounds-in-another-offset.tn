!!id:"https://tson.io/test-suite/class2/schema/valid/a-datetime-refinement-restating-its-bounds-in-another-offset.tn"
!!import:"https://tson.io/2026/40/m/temporal.tn"
!schema {
  trading_day     => !datetime ^ { exclusive_min: "2026-03-02T09:00:00+01:00"  max: "2026-03-02T17:30:00+01:00" }
  trading_day_utc => !trading_day ^ { exclusive_min: "2026-03-02T08:00:00Z"  max: "2026-03-02T16:30:00Z" }
}
