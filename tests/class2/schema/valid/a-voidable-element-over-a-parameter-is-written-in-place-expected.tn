!!id:"https://tson.io/test-suite/class2/schema/valid/a-voidable-element-over-a-parameter-is-written-in-place-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §5.3 (a parameter in a type written in place, proposed for Revision 40)"
  description: """
    A `?` element over a parameter is written in place, `voidable` bound beside `T` at the element, and survives
    substitution as any other field of the construction does.
    """
  valid: {
    resolved: """
      !schema {
        page => !meta.record {
          parameters: [ !meta.param { name: T } ]
          fields: { items => !meta.record_field { type: { of: !meta.array { element_type: T  voidable: true } } } }
        }

        @meta.application:{ head: page  arguments: [text] }
        text_page => !meta.record { fields: {
          items => !meta.record_field { type: { of: !meta.array { element_type: text  voidable: true } } }
        } }
      }
      """
  }
}
