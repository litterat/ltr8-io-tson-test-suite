!!id:"https://tson.io/test-suite/class2/schema/valid/an-application-at-a-field-is-written-in-place-under-its-constructor-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §5.3 (inline types, proposed for Revision 40)"
  description: """
    An application at a field is written in place under the constructor it builds with: `set<text>` completes the
    incomplete entry `meta.set_type`, `!meta.array { element_type: text  ordered: false  unique_items: true }`, and
    `meta.ref<order>` constructs `!meta.ref { of: order }`. Each is held in the wrapper and carries no key.
    """
  valid: {
    resolved: """
      !schema {
        order => !meta.record { fields: { id => !meta.record_field { type: text } } }

        post => !meta.record { fields: {
          labels => !meta.record_field { type: { of: !meta.array { element_type: text  ordered: false  unique_items: true } } }
          target => !meta.record_field { type: { of: !meta.ref { of: order } } }
        } }
      }
      """
  }
}
