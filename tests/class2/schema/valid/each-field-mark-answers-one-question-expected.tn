!!id:"https://tson.io/test-suite/class2/schema/valid/each-field-mark-answers-one-question-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2"
  description: "One slot per question, and each resolves to the one fact it answers: `?` on the name is `optional` (the key may be omitted), `?` on the type is `voidable` (a written `_` is admitted), and `~`/`=` give the `role` and its `value`. A pin on an unmarked name is a marker the document must write; on a marked one, omission supplies it. A default beside a voidable type keeps `_` as a way to clear the field. Facts at their defaults are omitted."
  meta: "meta.tn"
  import: ["core.tn"]
  valid: {
    resolved: """
      !schema {
        entry => !type_definition {
          body: !record { fields: [
            !record_field { name: name      type: text }
            !record_field { name: nickname  type: text   optional: true }
            !record_field { name: from      type: int32  voidable: true }
            !record_field { name: note      type: text   optional: true  voidable: true }
            !record_field { name: timeout   type: int32  optional: true  voidable: true  role: DEFAULT  value: 30 }
            !record_field { name: version   type: text   role: FIXED  value: "2.0" }
            !record_field { name: kind      type: text   optional: true  role: FIXED  value: "entry" }
          ] }
        }
      }
      """
  }
}
