!!id:"https://tson.io/test-suite/class2/schema/valid/a-type-a-composed-constructor-built-is-refined-by-its-facets-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.6, [TSON-SCHEMA] §5.7"
  description: """
    `names` is `!my_list { element_type: text }`, a type built by a constructor that IS-A `meta.array`, so it is
    refined by `^` under the collection facets' kinds: `max_items` is an ordered bound, written where `names` wrote
    none. The refinement carries `names`'s constructor as its tag and `names` in its chain, and its binding record
    keeps `names`'s `element_type` with the bound merged over it; `min_items` is still `my_list`'s pin, from the
    vocabulary.
    """
  valid: {
    resolved: """
      !schema {
        few => !my_list { chain: { supertypes: [names] }  element_type: text  max_items: 3 }
      }
      """
  }
