!!id:"https://tson.io/test-suite/class2/schema/valid/atom-refinement-narrows-its-source-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.9"
  description: "An atom refinement merges with its source rather than replacing it: the resolved body carries every facet the source had settled, not only the ones the refinement restated. Its tag is the atom constructor family's, and the name it refined heads its chain."
  meta: "meta.tn"
  import: ["core.tn"]
  valid: {
    resolved: """
      !schema {
        small => !integer_type { supertypes: [int32]  size: { bits: 32  signed: true }  min: 0  max: 10 }
      }
      """
  }
}
