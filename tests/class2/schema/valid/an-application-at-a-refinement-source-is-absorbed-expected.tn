!!id:"https://tson.io/test-suite/class2/schema/valid/an-application-at-a-refinement-source-is-absorbed-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.7, [TSON-SCHEMA] §5.8, [TSON-SCHEMA] §5.10 (inline types, proposed for Revision 40)"
  description: """
    An application at a refinement source is absorbed by value as one at a composition operand is: `fixed` refines
    the substituted record, adding no entry, and is IS-A the declaration `text_box` that names `box<text>`, never
    the open record `box`.
    """
  valid: {
    resolved: """
      !schema {
        box => !meta.record {
          parameters: [ !meta.param { name: T } ]
          fields: { v => !meta.record_field { type: T } }
        }

        @meta.application:{ head: box  arguments: [text] }
        text_box => !meta.record { chain: { subtypes: [fixed] }  fields: {
          v => !meta.record_field { type: text }
        } }

        fixed => !meta.record { chain: { supertypes: [text_box] }  fields: {
          v => !meta.record_field { type: text  optional: true  role: FIXED  value: a }
        } }
      }
      """
  }
}
