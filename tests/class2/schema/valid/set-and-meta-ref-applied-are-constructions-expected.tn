!!id:"https://tson.io/test-suite/class2/schema/valid/set-and-meta-ref-applied-are-constructions-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.3, [TSON-SCHEMA] §4.2, [TSON-SCHEMA] §8.2"
  description: """
    The kernel declares no template. The root's `set` is an alias of the incomplete entry `meta.set_type`, so
    `set<text>` completes it, `!meta.array { element_type: text  ordered: false  unique_items: true }`, and its key
    carries `@meta.completion` naming `meta.set_type`, past the alias; `meta.ref` is the kernel's one reference
    constructor, so `meta.ref<meta.record>` is `!meta.ref { of: meta.record }`. Neither carries `@meta.application`:
    each states its constructor and its arguments, and substitutes nothing.
    """
  valid: {
    resolved: """
      !schema {
        @meta.completion:{ of: [meta.set_type] }
        tags => !meta.array { element_type: text  ordered: false  unique_items: true }

        records => !meta.ref { of: meta.record }
      }
      """
  }
}
