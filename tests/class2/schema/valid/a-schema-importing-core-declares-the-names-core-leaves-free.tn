!!id:"https://tson.io/test-suite/class2/schema/valid/a-schema-importing-core-declares-the-names-core-leaves-free.tn"
{
  identifier       => !identifier_type { continue_add: "-" }
  positive_integer => !integer ^ { min: 1 }
  non_empty_text   => !text ^ { min_length: 1 }
  documentation    => @annotation text
}
