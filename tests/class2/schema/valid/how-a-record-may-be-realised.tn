!!id:"https://tson.io/test-suite/class2/schema/valid/how-a-record-may-be-realised.tn"
!!import:"https://tson.io/2026/39/m/meta.tn"
!!import:"https://tson.io/2026/39/m/core.tn"
!schema {
  pet => abstract {
    pet_type: text =?
    name: text
  }

  dog => pet & {
    pet_type?: = "dog"
  }

  shape => abstract {
    area: int32
  }

  reading => final {
    sensor: text
  }

  plain => {
    note: text
  }
}
