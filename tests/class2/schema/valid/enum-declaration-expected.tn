!!id:"https://tson.io/test-suite/class2/schema/valid/enum-declaration-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5"
  description: "An enum declaration resolves to an ATOM entry whose source is the enum constructor and whose members keep the order they were written in."
  valid: {
    resolved: """
      !schema {
        colour => !enum { members: [RED GREEN BLUE] }
      }
      """
  }
}
