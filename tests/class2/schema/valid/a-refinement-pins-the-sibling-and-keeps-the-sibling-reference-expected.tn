!!id:"https://tson.io/test-suite/class2/schema/valid/a-refinement-pins-the-sibling-and-keeps-the-sibling-reference-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2, [TSON-SCHEMA] §5.7"
  description: """
    A dependent field's type is fixed by pinning its sibling, not by restating the field: `int_cell` pins `kind` to
    `int32`, so every `int_cell` reads `v` as an `int32`. The refinement's materialised body keeps `v` as `type:
    kind!` beside the pin, so the field is spelled the same way on every member of the family.
    """
  valid: {
    resolved: """
      !schema {
        cell => !meta.record { chain: { subtypes: [int_cell] }  fields: {
          kind => !meta.record_field { type: meta.type_ref }
          v    => !meta.record_field { type: kind!  optional: true }
        } }

        int_cell => !meta.record { chain: { supertypes: [cell] }  fields: {
          kind => !meta.record_field { type: meta.type_ref  optional: true  role: FIXED  value: int32 }
          v    => !meta.record_field { type: kind!  optional: true }
        } }
      }
      """
  }
}
