!!id:"https://tson.io/test-suite/class2/schema/valid/a-dot-the-profile-excludes-is-no-dot-of-a-key-type-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §7.4"
  description: """
    A `key_type` is refused only where its profile admits U+002E, and Continue is `continue` with `continue_add`,
    less `exclude`: `segment` adds `.` and excludes it, so its Continue holds `-` and no `.`, and it keys a
    namespace.
    """
  valid: {
    resolved: """
      !schema {
        segment => !unicode.identifier_type { continue_add: "-."  exclude: "." }
        index => !meta.namespace { key_type: segment  value_type: text }
      }
      """
  }
}
