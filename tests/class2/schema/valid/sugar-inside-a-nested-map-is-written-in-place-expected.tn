!!id:"https://tson.io/test-suite/class2/schema/valid/sugar-inside-a-nested-map-is-written-in-place-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.3, [TSON-SCHEMA] §8.1 (nested schema maps and inline types, proposed for Revision 40)"
  description: """
    A sugar form written inside a nested map resolves in place as it does at the root: `[uuid]` in `geo.tagged` and
    in `other` is each the construction at its own field, and nothing is added at the root or in the nested map.
    """
  valid: {
    resolved: """
      !schema {
        geo => !meta.schema {
          tagged => !meta.record { fields: {
            ids => !meta.record_field { type: { of: !meta.array { element_type: uuid } } }
          } }
        }

        other => !meta.record { fields: {
          ids => !meta.record_field { type: { of: !meta.array { element_type: uuid } } }
        } }
      }
      """
  }
}
