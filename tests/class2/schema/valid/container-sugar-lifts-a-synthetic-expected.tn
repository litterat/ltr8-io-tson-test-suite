!!id:"https://tson.io/test-suite/class2/schema/valid/container-sugar-lifts-a-synthetic-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.3, [TSON-SCHEMA] §8.2"
  description: "A container sugar form written at a field position lifts to its own closed entry, referenced by name; the entry carries the derived @meta.synthetic marker at its key and its trailing hash is not normative."
  valid: {
    resolved: """
      !schema {
        post => !meta.record { fields: {
          title => !meta.record_field { type: text }
          ids   => !meta.record_field { type: array_uuid_xxhash }
        } }
      
        @meta.synthetic array_uuid_xxhash => !meta.array { element_type: uuid }
      }
      """
  }
}
