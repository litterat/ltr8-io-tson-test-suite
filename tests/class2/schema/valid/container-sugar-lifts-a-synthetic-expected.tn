!!id:"https://tson.io/test-suite/class2/schema/valid/container-sugar-lifts-a-synthetic-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.3, [TSON-SCHEMA] §8.2"
  description: "A container sugar form written at a field position lifts to its own closed entry, referenced by name; the entry carries the derived @synthetic marker at its key and its trailing hash is not normative."
  meta: "meta.tn"
  import: ["core.tn"]
  valid: {
    resolved: """
      !schema {
        post => !type_definition {
          body: !record { fields: [
            !record_field { name: title  type: text }
            !record_field { name: tags   type: array_text_xxhash }
          ] }
        }
      
        @synthetic array_text_xxhash => !type_definition {
          source: array
          body: !array { element_type: text }
        }
      }
      """
  }
}
