!!id:"https://tson.io/test-suite/class2/schema/valid/an-open-record-states-its-parameters-and-holds-its-references-as-written-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §5.3, [TSON-SCHEMA] §8.1"
  description: """
    A template is an open record: a `!meta.record` carrying `parameters`, read against `record`'s own vocabulary as any
    record is. A parameter is a reference value, written where it stands as its name: whole at a field's `type`, as an
    argument of an application there (`box<T>`), at a slot of a type written in place there (`[T]`, the array with `T`
    at its element), and in an applied parent (`chain.parents`). A field type naming no parameter, `int32`, is closed
    in the open record.
    """
  valid: {
    resolved: """
      !schema {
        box => !meta.record {
          parameters: [ !meta.param { name: T } ]
          fields: { v => !meta.record_field { type: T } }
        }

        page => !meta.record {
          chain: { parents: [box<T>] }
          parameters: [ !meta.param { name: T } ]
          fields: {
            v     => !meta.record_field { type: T }
            items => !meta.record_field { type: { of: !meta.array { element_type: T } } }
            first => !meta.record_field { type: box<T> }
            total => !meta.record_field { type: int32 }
          }
        }
      }
      """
  }
}
