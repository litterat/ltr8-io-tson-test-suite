!!id:"https://tson.io/test-suite/class2/schema/valid/a-record-in-place-over-a-parameter-closes-with-its-open-record-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §5.2 (a parameter in a type written in place, proposed for Revision 40)"
  description: """
    A record written in place over a parameter is a record body whose field types are slots the parameter stands at:
    `meta` holds `T` at `cursor`. Applying `page` substitutes the argument there, declared (`order_page`) and at a
    slot (`p`), where the record `page<order>` closes to holds the record in place over `order`.
    """
  valid: {
    resolved: """
      !schema {
        order => !meta.record { fields: { id => !meta.record_field { type: text } } }

        page => !meta.record {
          parameters: [ !meta.param { name: T } ]
          fields: { meta => !meta.record_field { type: { of: !meta.record { fields: {
            cursor => !meta.record_field { type: T }
            total  => !meta.record_field { type: int32 }
          } } } } }
        }

        @meta.application:page<order>
        order_page => !meta.record { fields: {
          meta => !meta.record_field { type: { of: !meta.record { fields: {
            cursor => !meta.record_field { type: order }
            total  => !meta.record_field { type: int32 }
          } } } }
        } }

        holder => !meta.record { fields: {
          p => !meta.record_field { type: { of: !meta.record { fields: {
            meta => !meta.record_field { type: { of: !meta.record { fields: {
              cursor => !meta.record_field { type: order }
              total  => !meta.record_field { type: int32 }
            } } } }
          } } } }
        } }
      }
      """
  }
}
