!!id:"https://tson.io/test-suite/class2/schema/valid/an-enum-draws-its-labels-from-a-vocabulary-the-schema-declares.tn"
!!import:"https://tson.io/2026/39/m/meta.tn"
!!import:"https://tson.io/2026/39/m/core.tn"
!schema {
  kebab => !identifier_type { continue_add: "-"  pattern: "[a-z]+(-[a-z]+)*" }

  steps => !enum_type { name_type: kebab  members: [make-tea drink-tea] }
}
