!!id:"https://tson.io/test-suite/class2/schema/valid/an-open-records-field-may-take-its-type-from-a-sibling-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2, [TSON-SCHEMA] §5.10"
  description: """
    An open record's field may be typed by a sibling: `v`'s sibling is `kind`, an ordinary field. A parameter is
    spelled bare and a sibling with `!`, so substitution cannot confuse the two: `pair<text>` closes `w` to `text` and
    leaves `v` as written, in the template and in the declared application alike.
    """
  valid: {
    resolved: """
      !schema {
        pair => !meta.record {
          fields: {
            kind => !meta.record_field { type: meta.type_ref }
            v    => !meta.record_field { type: kind!  optional: true }
            w    => !meta.record_field { type: T }
          }
          parameters: [ !meta.param { name: T } ]
        }

        @meta.application:pair<text>
        p => !meta.record {
          fields: {
            kind => !meta.record_field { type: meta.type_ref }
            v    => !meta.record_field { type: kind!  optional: true }
            w    => !meta.record_field { type: text }
          }
        }
      }
      """
  }
}
