!!id:"https://tson.io/test-suite/class2/schema/valid/a-family-base-names-the-entries-its-members-name-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §8.2"
  description: """
    A field type in a record template that names none of its parameters means the same in every application, so the
    family base names the entry each member names: `bounded<9>` is its expansion in `pet` as in `cat`, and so is
    `N`'s derived type. A position typed by `pet` reads the selector at that entry before it knows the member.
    """
  valid: {
    resolved: """
      !schema {
        bounded => !meta.template {
          parameters: [ !meta.template_param { name: M  type: integer } ]
          template: "!numeric.integer_type { max: M }"
        }

        pet => !meta.record_template {
          chain: { subtypes: [cat] }
          fields: {
            kind => !meta.record_template_field { type: numeric_integer_type_9_xxhash  role: FIXED  value_param: N }
            name => !meta.record_template_field { type: text }
          }
          discriminators: [kind]
          parameters: [ !meta.template_param { name: N  type: numeric_integer_type_9_xxhash } ]
        }

        @meta.application:pet<3>
        cat => !meta.record {
          chain: { supertypes: [pet] }
          fields: {
            kind => !meta.record_field { type: numeric_integer_type_9_xxhash  role: FIXED  value: 3 }
            name => !meta.record_field { type: text }
          }
        }

        @meta.synthetic numeric_integer_type_9_xxhash => !numeric.integer_type { max: 9 }
      }
      """
  }
}
