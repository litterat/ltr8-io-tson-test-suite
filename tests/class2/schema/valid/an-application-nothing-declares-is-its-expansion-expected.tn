!!id:"https://tson.io/test-suite/class2/schema/valid/an-application-nothing-declares-is-its-expansion-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §8.2"
  description: "An application of a template over any constructor but record, written at a use site and declared nowhere, is its expansion: the position names the closed synthetic its closing produces, the same entry the sugar form written out lands on, and no instantiation entry is minted. rows<uuid> and [uuid; 1..] are one entry."
  valid: {
    resolved: """
      !schema {
        rows => !meta.template {
          parameters: [ !meta.template_param { name: T  type: meta.type_kind } ]
          template: "!meta.array { element_type: T  min_items: 1 }"
        }

        post => !meta.record { fields: {
          a => !meta.record_field { type: array_uuid_1_xxhash }
          b => !meta.record_field { type: array_uuid_1_xxhash }
        } }

        @meta.synthetic array_uuid_1_xxhash => !meta.array { element_type: uuid  min_items: 1 }
      }
      """
  }
}
