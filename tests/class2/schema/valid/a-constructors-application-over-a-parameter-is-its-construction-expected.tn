!!id:"https://tson.io/test-suite/class2/schema/valid/a-constructors-application-over-a-parameter-is-its-construction-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §5.3 (a parameter in a type written in place, proposed for Revision 40)"
  description: """
    A constructor's application over a parameter is its construction in place at the open record, the parameter at
    its slot, so the explicit spelling and the sugar are one resolved form: `explicit` and `sugar` state the same
    fields, and their applications close to the same records.
    """
  valid: {
    resolved: """
      !schema {
        order => !meta.record { fields: { id => !meta.record_field { type: text } } }

        explicit => !meta.record {
          parameters: [ !meta.param { name: T } ]
          fields: {
            a => !meta.record_field { type: { of: !meta.array { element_type: T } } }
            m => !meta.record_field { type: { of: !meta.map {
              key_type: text
              value_type: { of: !meta.array { element_type: T } }
            } } }
            s => !meta.record_field { type: { of: !meta.set_type { element_type: T } } }
            r => !meta.record_field { type: { of: !meta.ref { of: T } } }
          }
        }

        sugar => !meta.record {
          parameters: [ !meta.param { name: T } ]
          fields: {
            a => !meta.record_field { type: { of: !meta.array { element_type: T } } }
            m => !meta.record_field { type: { of: !meta.map {
              key_type: text
              value_type: { of: !meta.array { element_type: T } }
            } } }
            s => !meta.record_field { type: { of: !meta.set_type { element_type: T } } }
            r => !meta.record_field { type: { of: !meta.ref { of: T } } }
          }
        }

        @meta.application:{ head: explicit  arguments: [order] }
        e => !meta.record { fields: {
          a => !meta.record_field { type: { of: !meta.array { element_type: order } } }
          m => !meta.record_field { type: { of: !meta.map {
            key_type: text
            value_type: { of: !meta.array { element_type: order } }
          } } }
          s => !meta.record_field { type: { of: !meta.set_type { element_type: order } } }
          r => !meta.record_field { type: { of: !meta.ref { of: order } } }
        } }

        @meta.application:{ head: sugar  arguments: [order] }
        g => !meta.record { fields: {
          a => !meta.record_field { type: { of: !meta.array { element_type: order } } }
          m => !meta.record_field { type: { of: !meta.map {
            key_type: text
            value_type: { of: !meta.array { element_type: order } }
          } } }
          s => !meta.record_field { type: { of: !meta.set_type { element_type: order } } }
          r => !meta.record_field { type: { of: !meta.ref { of: order } } }
        } }
      }
      """
  }
}
