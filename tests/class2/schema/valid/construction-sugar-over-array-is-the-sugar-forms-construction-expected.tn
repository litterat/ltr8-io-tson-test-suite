!!id:"https://tson.io/test-suite/class2/schema/valid/construction-sugar-over-array-is-the-sugar-forms-construction-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.3 (construction sugar and inline types, proposed for Revision 40), [TSON-SCHEMA] §8.1"
  description: """
    `meta.array` is a constructor with no parameters, and its one required field typed by a type slot is
    `element_type`, so `meta.array<uuid>` is construction sugar for `!meta.array { element_type: uuid }` -- the
    construction `[uuid]` is spelled for. Written at a field, each resolves in place to that construction in the
    wrapper, carrying no `@meta.application`, since nothing was substituted.
    """
  valid: {
    resolved: """
      !schema {
        post => !meta.record { fields: {
          a => !meta.record_field { type: { of: !meta.array { element_type: uuid } } }
          b => !meta.record_field { type: { of: !meta.array { element_type: uuid } } }
        } }
      }
      """
  }
}
