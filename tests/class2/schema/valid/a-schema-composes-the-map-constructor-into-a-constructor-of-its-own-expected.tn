!!id:"https://tson.io/test-suite/class2/schema/valid/a-schema-composes-the-map-constructor-into-a-constructor-of-its-own-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §4.1, [TSON-SCHEMA] §4.2"
  description: """
    Any schema may declare a constructor, by composing a constructor it imports. `meta.map` composes `meta.product`,
    so the chain of `labelled_map` reaches exactly one base kind and the entry is a constructor by its chain. Its
    body is the complete inherited field set, `meta.map`'s pins and defaults with their values, and its
    own field after them. Declaring it is valid; whether a processor backs an instance of a schema's own constructor
    of types is the processor's, so no instance is written here.
    """
  valid: {
    resolved: """
      !schema {
        labelled_map => !meta.record {
          chain: { supertypes: [meta.map meta.product meta.top meta.type] }
          fields: {
            chain          => !meta.record_field { type: meta.type_chain  optional: true }
            access_pattern => !meta.record_field {
              type: meta.product_access_type  optional: true  role: FIXED  value: NAMED
            }
            size_type      => !meta.record_field {
              type: meta.product_size_type  optional: true  role: FIXED  value: VARIABLE
            }
            key_type       => !meta.record_field { type: meta.type_ref }
            value_type     => !meta.record_field { type: meta.type_expr }
            voidable       => !meta.record_field { type: boolean  optional: true  role: DEFAULT  value: false }
            ordered        => !meta.record_field { type: boolean  optional: true  role: DEFAULT  value: false }
            min_items      => !meta.record_field { type: numeric.count  optional: true }
            max_items      => !meta.record_field { type: numeric.count  optional: true }
            label          => !meta.record_field { type: text  optional: true }
          }
        }
      }
      """
  }
}
