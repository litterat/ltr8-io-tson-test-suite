!!id:"https://tson.io/test-suite/class2/schema/valid/a-qualified-name-names-a-supertype-a-refinement-source-and-a-subtraction-source.tn"
!!import:"https://tson.io/2026/39/m/meta.tn"
!!import:"https://tson.io/2026/39/m/core.tn"
!schema {
  geo => !schema {
    base  => { id: text  note?: text }
    small => !int32 ^ { min: 0  max: 100 }
  }
  derived  => geo.base & { more: text }
  narrower => !geo.small ^ { max: 10 }
  trimmed  => geo.base - { note }
}
