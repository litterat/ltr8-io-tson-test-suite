!!id:"https://tson.io/test-suite/class2/schema/valid/a-record-templates-fields-label-a-whole-parameter-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §8.1"
  description: """
    A record template's field names a parameter standing for its whole type as `type_param` and one standing for its
    whole value as `value_param`; `type` and `value` are as on a record field, so a literal on a closed type stays a
    `value`. A parameter as an argument of an application stays in `type`, recognised there because its text
    resolves into the template's `parameters`: `box<T>` is `b`'s type in every application, `T` substituted.
    """
  valid: {
    resolved: """
      !schema {
        box => !meta.record_template {
          fields: { v => !meta.record_template_field { type_param: X } }
          parameters: [ !meta.template_param { name: X  type: meta.type_ref } ]
        }

        slot => !meta.record_template {
          fields: {
            a => !meta.record_template_field { type_param: T }
            b => !meta.record_template_field { type: box<T> }
            c => !meta.record_template_field { type_param: T  optional: true  role: DEFAULT  value_param: V }
            d => !meta.record_template_field { type: int32  optional: true  role: DEFAULT  value_param: N }
            e => !meta.record_template_field { type: text  optional: true  role: DEFAULT  value: "x" }
          }
          parameters: [
            !meta.template_param { name: T  type: meta.type_ref }
            !meta.template_param { name: V  type: T }
            !meta.template_param { name: N  type: int32 }
          ]
        }
      }
      """
  }
}
