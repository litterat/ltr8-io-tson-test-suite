!!id:"https://tson.io/test-suite/class2/schema/valid/a-refinement-of-a-map-type-restating-its-type-slots-through-aliases.tn"
!!import:"https://tson.io/2026/40/m/core.tn"
!schema {
  word  => text
  tally => int32
  index => {text => int32}
  small => !index ^ { key_type: word  value_type: tally  max_items: 3 }
}
