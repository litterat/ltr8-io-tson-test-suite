!!id:"https://tson.io/test-suite/class2/schema/valid/a-sugar-bodied-declaration-holding-a-constructors-application-is-its-construction-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.3, [TSON-SCHEMA] §5.10 (construction sugar, proposed for Revision 40)"
  description: """
    A declaration whose body is a sugar form is the construction the form denotes, and a constructor's application
    among its positions is that constructor's construction in place, as it is at a field: `x => [meta.array<box<text>>]`
    resolves to the array whose element is `[box<text>]`, the very type `k`'s field `f` holds, and `box<text>` closes
    in place inside it.
    """
  valid: {
    resolved: """
      !schema {
        box => !meta.record {
          parameters: [ !meta.param { name: T } ]
          fields: { v => !meta.record_field { type: T } }
        }

        x => !meta.array { element_type: { of: !meta.array {
          element_type: { of: !meta.record { fields: { v => !meta.record_field { type: text } } } }
        } } }

        k => !meta.record { fields: {
          f => !meta.record_field { type: { of: !meta.array { element_type: { of: !meta.array {
            element_type: { of: !meta.record { fields: { v => !meta.record_field { type: text } } } }
          } } } } }
        } }
      }
      """
  }
}
