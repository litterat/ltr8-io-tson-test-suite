!!id:"https://tson.io/test-suite/class2/schema/valid/an-incomplete-entry-refined-then-completed-accumulates-its-fields-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5"
  description: """
    A refinement of an incomplete entry writes fields its base has not written and is another incomplete entry;
    the completion writes the rest. `capped<text>` is the construction over everything each step wrote.
    """
  valid: {
    resolved: """
      !schema {
        @meta.completion:{ of: [capped bounded] }
        tags => !meta.array { element_type: text  min_items: 2  max_items: 5 }
      }
      """
  }
}
