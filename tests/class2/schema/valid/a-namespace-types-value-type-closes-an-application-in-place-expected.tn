!!id:"https://tson.io/test-suite/class2/schema/valid/a-namespace-types-value-type-closes-an-application-in-place-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.1, [TSON-SCHEMA] §5.10, [TSON-SCHEMA] §8.2"
  description: """
    A namespace type's `value_type` is a type slot like a map type's, so an application standing there closes in
    place: `box<text>` is the record `{ v: text }` held in the wrapper at `value_type`, with no name and no entry.
    """
  valid: {
    resolved: """
      !schema {
        box => !meta.record {
          parameters: [ !meta.param { name: T } ]
          fields: { v => !meta.record_field { type: T } }
        }

        api => !meta.namespace {
          key_type: meta.identifier
          value_type: { of: !meta.record { fields: { v => !meta.record_field { type: text } } } }
        }
      }
      """
  }
}
