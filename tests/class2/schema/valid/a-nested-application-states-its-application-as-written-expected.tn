!!id:"https://tson.io/test-suite/class2/schema/valid/a-nested-application-states-its-application-as-written-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.3, [TSON-SCHEMA] §8.2"
  description: """
    A nested application closes innermost first: `box<text>` is the entry `inner` declares, and `pair` is
    applied to it. The entry's `@meta.application` states the reference as written, its nested argument
    unreduced, `pair<box<text> int32>`, and each level resolves structurally to the entry it closed to:
    `box<text>` to `inner`, whose own `@meta.application` is `box<text>`.
    """
  valid: {
    resolved: """
      !schema {
        box => !meta.record {
          parameters: [ !meta.param { name: T } ]
          fields: { v => !meta.record_field { type: T } }
        }

        pair => !meta.record {
          parameters: [
            !meta.param { name: A }
            !meta.param { name: B }
          ]
          fields: {
            a => !meta.record_field { type: A }
            b => !meta.record_field { type: B }
          }
        }

        @meta.application:box<text>
        inner => !meta.record { fields: { v => !meta.record_field { type: text } } }

        @meta.application:pair<box<text> int32>
        outer => !meta.record {
          fields: {
            a => !meta.record_field { type: inner }
            b => !meta.record_field { type: int32 }
          }
        }
      }
      """
  }
}
