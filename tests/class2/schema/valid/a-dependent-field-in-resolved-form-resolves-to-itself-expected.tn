!!id:"https://tson.io/test-suite/class2/schema/valid/a-dependent-field-in-resolved-form-resolves-to-itself-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §5.2, [TSON-SCHEMA] §8.1"
  description: """
    A dependent field's type is a dependent type written in place, `{ of: !meta.dependent { on: kind } }`, of which
    `kind!` is the schema grammar's sugar. Written by hand at `record_field.type` in the explicit form, the
    construction is the dependent field, and it resolves to itself.
    """
  valid: {
    resolved: """
      !schema {
        cell => !meta.record { fields: {
          kind => !meta.record_field { type: meta.type_ref }
          v    => !meta.record_field { type: { of: !meta.dependent { on: kind } }  optional: true }
        } }
      }
      """
  }
}
