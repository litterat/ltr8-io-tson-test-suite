!!id:"https://tson.io/test-suite/class2/schema/valid/construction-sugar-over-map-is-the-sugar-forms-construction-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.3 (construction sugar and inline types, proposed for Revision 40), [TSON-SCHEMA] §8.1"
  description: """
    `meta.map`'s required fields typed by a type slot are `key_type` and `value_type`, in that order, so
    `meta.map<text int32>` is `!meta.map { key_type: text  value_type: int32 }`, an argument for each field in
    declaration order -- the construction `{text => int32}` is spelled for. Written at a field, each resolves in
    place to that construction in the wrapper.
    """
  valid: {
    resolved: """
      !schema {
        post => !meta.record { fields: {
          a => !meta.record_field { type: { of: !meta.map { key_type: text  value_type: int32 } } }
          b => !meta.record_field { type: { of: !meta.map { key_type: text  value_type: int32 } } }
        } }
      }
      """
  }
}
