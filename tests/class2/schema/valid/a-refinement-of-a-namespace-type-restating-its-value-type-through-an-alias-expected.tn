!!id:"https://tson.io/test-suite/class2/schema/valid/a-refinement-of-a-namespace-type-restating-its-value-type-through-an-alias-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.7, [TSON-SCHEMA] §8.3"
  description: """
    `value_type` keeps `meta.map`'s rule through `meta.namespace`'s composition: `summary` is `text` under another
    name, so it restates `api`'s value type, and `small` is a namespace type IS-A `api`. The resolved value states
    the slot as the source wrote it, `value_type: text`.
    """
  valid: {
    resolved: """
      !schema {
        summary => !meta.alias { target: text }
        api     => !meta.namespace { chain: { subtypes: [small] }  key_type: meta.identifier  value_type: text }
        small   => !meta.namespace {
          chain: { supertypes: [api] }
          key_type: meta.identifier  value_type: text  max_items: 3
        }
      }
      """
  }
}
