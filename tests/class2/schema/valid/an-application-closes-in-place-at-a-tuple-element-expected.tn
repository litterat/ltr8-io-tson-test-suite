!!id:"https://tson.io/test-suite/class2/schema/valid/an-application-closes-in-place-at-a-tuple-element-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §8.2 (inline types, proposed for Revision 40)"
  description: """
    A tuple element's `element_type` is a type slot, so an application of an open record there closes in place: the
    second element of `[text, box<text>]` holds the record `box<text>` closes to, with no name and no entry.
    """
  valid: {
    resolved: """
      !schema {
        box => !meta.record {
          parameters: [ !meta.param { name: T } ]
          fields: { v => !meta.record_field { type: T } }
        }

        pair => !meta.tuple { elements: [
          !meta.tuple_element { element_type: text }
          !meta.tuple_element { element_type: { of: !meta.record { fields: { v => !meta.record_field { type: text } } } } }
        ] }
      }
      """
  }
}
