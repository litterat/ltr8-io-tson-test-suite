!!id:"https://tson.io/test-suite/class2/schema/valid/a-declared-application-of-an-open-record-closes-to-a-record-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §5.3, [TSON-SCHEMA] §8.1 (inline types, proposed for Revision 40)"
  description: """
    An application of an open record substitutes its arguments for the parameters and closes to a `!meta.record`
    without `parameters`. A declaration naming the application is that record under its author's name, and carries
    `@meta.application` on its key, the one fact the record does not state. `[T]` is the array written in place
    with `T` at its element, and substituting `text` there gives the array over `text`, still in the wrapper: nothing
    is added to the schema.
    """
  valid: {
    resolved: """
      !schema {
        page => !meta.record {
          parameters: [ !meta.param { name: T } ]
          fields: {
            items => !meta.record_field { type: { of: !meta.array { element_type: T } } }
            total => !meta.record_field { type: int32 }
          }
        }

        @meta.application:page<text>
        text_page => !meta.record { fields: {
          items => !meta.record_field { type: { of: !meta.array { element_type: text } } }
          total => !meta.record_field { type: int32 }
        } }
      }
      """
  }
}
