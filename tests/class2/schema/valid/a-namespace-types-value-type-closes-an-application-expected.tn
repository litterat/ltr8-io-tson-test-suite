!!id:"https://tson.io/test-suite/class2/schema/valid/a-namespace-types-value-type-closes-an-application-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.1, [TSON-SCHEMA] §5.10, [TSON-SCHEMA] §8.2"
  description: """
    A namespace type's `value_type` is a type position like a map type's, so an application standing there closes
    to the entry it denotes: `box<text>` is its expansion, the record `{ v: text }`, and `api` names it.
    """
  valid: {
    resolved: """
      !schema {
        box => !meta.record {
          parameters: [ !meta.param { name: T } ]
          fields: { v => !meta.record_field { type: T } }
        }

        api => !meta.namespace { key_type: meta.identifier  value_type: record_v_text_xxhash }

        @meta.synthetic record_v_text_xxhash => !meta.record { fields: { v => !meta.record_field { type: text } } }
      }
      """
  }
}
