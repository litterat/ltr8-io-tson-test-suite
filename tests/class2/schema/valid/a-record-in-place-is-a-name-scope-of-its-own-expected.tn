!!id:"https://tson.io/test-suite/class2/schema/valid/a-record-in-place-is-a-name-scope-of-its-own-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2, [TSON-SCHEMA] §11.4 (a record written in place, proposed for Revision 40)"
  description: """
    A record written in place is a scope of field names of its own, as a declared record is, and the record holding it
    is another: `comer` beside `at` and `corner` inside it are in two scopes, so the look-alike rule compares neither
    with the other.
    """
  valid: {
    resolved: """
      !schema {
        order => !meta.record { fields: {
          comer => !meta.record_field { type: int32 }
          at    => !meta.record_field { type: { of: !meta.record { fields: { corner => !meta.record_field { type: int32 } } } } }
        } }
      }
      """
  }
}
