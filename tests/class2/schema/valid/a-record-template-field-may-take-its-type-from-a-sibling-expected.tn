!!id:"https://tson.io/test-suite/class2/schema/valid/a-record-template-field-may-take-its-type-from-a-sibling-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2, [TSON-SCHEMA] §5.10"
  description: """
    A record template's field may be typed by a sibling: `v`'s sibling is `kind`, an ordinary field. A parameter is
    spelled bare and a sibling with `!`, so substitution cannot confuse the two: `pair<text>` closes `w` to `text` and
    leaves `v` as written, in the template and in its member alike.
    """
  valid: {
    resolved: """
      !schema {
        pair => !meta.record_template {
          chain: { subtypes: [p] }
          fields: {
            kind => !meta.record_template_field { type: meta.type_ref }
            v    => !meta.record_template_field { type: kind!  optional: true }
            w    => !meta.record_template_field { type_param: T }
          }
          parameters: [ !meta.template_param { name: T  type: meta.type_ref } ]
        }

        @meta.application:pair<text>
        p => !meta.record {
          chain: { supertypes: [pair] }
          fields: {
            kind => !meta.record_field { type: meta.type_ref }
            v    => !meta.record_field { type: kind!  optional: true }
            w    => !meta.record_field { type: text }
          }
        }
      }
      """
  }
}
