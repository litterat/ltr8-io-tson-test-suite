!!id:"https://tson.io/test-suite/class2/schema/valid/an-alias-is-stated-as-written-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §8.3"
  description: "An alias is a hop, not a rewrite: a type position naming an ALIAS entry states that name, and the chain stays walkable through the entries themselves. When a processor collapses the chain is its own choice, and it is made after linking, when readers are built."
  valid: {
    resolved: """
      !schema {
        user_id => !alias { target: text }

        user => !record { fields: {
          key => !record_field { type: user_id }
        } }
      }
      """
  }
}
