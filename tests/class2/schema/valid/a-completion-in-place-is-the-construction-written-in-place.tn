!!id:"https://tson.io/test-suite/class2/schema/valid/a-completion-in-place-is-the-construction-written-in-place.tn"
!!import:"https://tson.io/2026/40/m/core.tn"
!schema {
  nonempty => !meta.array ^ { min_items: 1 }
  holder   => { a: nonempty<text>  b: [text; 1..] }
  spelled  => !meta.map { key_type: text  value_type: { of: !nonempty { element_type: text } } }
}
