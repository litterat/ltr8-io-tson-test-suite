!!id:"https://tson.io/test-suite/class2/schema/valid/an-application-of-an-incomplete-entry-fills-its-absent-type-slots-in-order-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5 (incomplete entries, proposed for Revision 40)"
  description: """
    `X<A ...>` fills the type slots `X` leaves absent, in the constructor's declared order: `keyed` wrote
    `key_type`, so its one argument is `value_type`; `open` wrote neither, so it takes both.
    """
  valid: {
    resolved: """
      !schema {
        @meta.completion:{ of: [keyed] }
        counts => !meta.map { key_type: text  value_type: int32 }
        @meta.completion:{ of: [open] }
        pairs  => !meta.map { key_type: text  value_type: uuid  voidable: true }
      }
      """
  }
}
