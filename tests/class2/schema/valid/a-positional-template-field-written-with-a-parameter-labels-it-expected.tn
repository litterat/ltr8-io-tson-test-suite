!!id:"https://tson.io/test-suite/class2/schema/valid/a-positional-template-field-written-with-a-parameter-labels-it-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.6, [TSON-SCHEMA] §5.10"
  description: """
    A field written positionally in an explicit record template, `item => T`, is `item => { type: T }`, and a
    parameter standing for its whole type is its `type_param`, as in the sugar `<T> { item: T }`.
    """
  valid: {
    resolved: """
      !schema {
        box => !meta.record_template {
          fields: { item => !meta.record_template_field { type_param: T } }
          parameters: [ !meta.template_param { name: T } ]
        }
      }
      """
  }
}
