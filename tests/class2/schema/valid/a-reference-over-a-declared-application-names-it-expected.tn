!!id:"https://tson.io/test-suite/class2/schema/valid/a-reference-over-a-declared-application-names-it-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §5.3, [TSON-SCHEMA] §5.10 (inline types, proposed for Revision 40)"
  description: """
    A reference's `of` holds a name, so a reference over an application of an open record names the declaration that
    closes it: `text_box => box<text>` is the record `{ v: text }` under its author's name, and both
    `!meta.reference_type { of: text_box … }` and `meta.ref<text_box>` refer to it. The two spellings resolve to one
    reference over one entry; a construction substitutes nothing and carries no `@meta.application`.
    """
  valid: {
    resolved: """
      !schema {
        box => !meta.record {
          parameters: [ !meta.param { name: T } ]
          fields: { v => !meta.record_field { type: T } }
        }

        @meta.application:box<text>
        text_box => !meta.record { fields: { v => !meta.record_field { type: text } } }

        written => !meta.reference_type { of: text_box  allow_sibling: false }

        applied => !meta.ref { of: text_box }
      }
      """
  }
}
