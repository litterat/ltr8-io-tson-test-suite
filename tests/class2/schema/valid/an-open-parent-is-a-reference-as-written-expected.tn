!!id:"https://tson.io/test-suite/class2/schema/valid/an-open-parent-is-a-reference-as-written-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.10, [TSON-SCHEMA] §8.1"
  description: """
    An open record keeps its parents as written in its chain, and a parent still applied to a parameter is
    an open application: a reference with an argument list, data grammar written unquoted. `ok` holds
    `parents: [result<T>]` beside the fields it absorbed, and closes with every other reference it holds.
    """
  valid: {
    resolved: """
      !schema {
        result => !meta.record {
          parameters: [ !meta.param { name: T } ]
          fields: { value => !meta.record_field { type: T  optional: true } }
          extension: ABSTRACT
        }

        ok => !meta.record {
          chain: { parents: [result<T>] }
          parameters: [ !meta.param { name: T } ]
          fields: {
            value => !meta.record_field { type: T  optional: true }
            done  => !meta.record_field { type: boolean }
          }
        }
      }
      """
  }
}
