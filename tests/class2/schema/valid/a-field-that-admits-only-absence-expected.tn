!!id:"https://tson.io/test-suite/class2/schema/valid/a-field-that-admits-only-absence-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2, [TSON-SCHEMA] §4.2"
  description: "A field that may be omitted or written as `_` and nothing else is spelled by its type: `void` admits only `_`, and `?` on the type admits it at the position. No pin is involved — a pin names a value of the field's type, and `_` is none — so the field resolves FREE, optional and voidable, with no `value`."
  meta: "meta.tn"
  import: ["core.tn"]
  valid: {
    resolved: """
      !schema {
        person => !type_definition {
          body: !record { fields: [
            !record_field { name: name     type: text }
            !record_field { name: retired  type: void  optional: true  voidable: true }
          ] }
        }
      }
      """
  }
}
