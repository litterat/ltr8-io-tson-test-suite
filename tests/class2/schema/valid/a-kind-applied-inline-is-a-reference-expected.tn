!!id:"https://tson.io/test-suite/class2/schema/valid/a-kind-applied-inline-is-a-reference-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §5.3, [TSON-SCHEMA] §8.1"
  description: """
    `meta.ref` is the kernel's one reference constructor, so `meta.ref<net.uuid_type>` is construction sugar for `!meta.ref { of: net.uuid_type }`, and a declaration whose
    body is the application is that construction under its author's name. A construction substitutes nothing, so it
    carries no `@meta.application`: its value states its constructor and its arguments. The resolved form of either
    spelling is its facets alone: what each admits is judged when the schema links.
    """
  valid: {
    resolved: """
      !schema {
        stock_id => !net.uuid_type {}

        words => !unicode.identifier_type { continue_add: "-"  medial: " " }

        ids => !meta.ref { of: net.uuid_type }

        names => !meta.ref { of: unicode.identifier_type }
      }
      """
  }
}
