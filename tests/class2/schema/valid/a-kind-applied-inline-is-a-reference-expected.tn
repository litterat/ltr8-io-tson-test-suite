!!id:"https://tson.io/test-suite/class2/schema/valid/a-kind-applied-inline-is-a-reference-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §8.1"
  description: """
    `meta.ref<uuid_type>` is the kernel's spelling of `!reference_type { of: uuid_type  allow_sibling: false }`, and
    a declaration whose body is the application is the entry, closed in place under its author's name. The resolved
    form of either spelling is its facets alone: what each admits is judged when the schema links.
    """
  valid: {
    resolved: """
      !schema {
        stock_id => !net.uuid_type {}

        words => !unicode.identifier_type { continue_add: "-"  medial: " " }

        @meta.application:meta.ref<net.uuid_type>
        ids => !meta.reference_type { of: net.uuid_type  allow_sibling: false }

        names => !meta.reference_type { of: unicode.identifier_type  allow_sibling: false }
      }
      """
  }
}
