!!id:"https://tson.io/test-suite/class2/schema/valid/choice-of-two-records-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.4, [TSON-SCHEMA] §8.2"
  description: "A choice resolves to a SUM entry naming its variants. Two record variants share a discrimination class, so the derived disjointness -- recorded on the choice body, which is the only thing with a variant list -- is false -- and a variant is not a subtype of the choice, subtypes being the inverse of the supertype relation and not of membership."
  valid: {
    resolved: """
      !schema {
        circle => !meta.record { fields: {
          radius => !meta.record_field { type: int32 }
        } }

        square => !meta.record { fields: {
          side => !meta.record_field { type: int32 }
        } }

        shape => !meta.choice { variants: [circle square]  disjoint: false }
      }
      """
  }
}
