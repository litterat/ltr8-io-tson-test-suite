!!id:"https://tson.io/test-suite/class2/schema/valid/a-refinement-of-a-refined-namespace-type-carries-its-complete-chain-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.5, [TSON-SCHEMA] §5.7 (a namespace type refined, proposed for Revision 40)"
  description: """
    A refined namespace type is itself refined as its source is: `smaller` raises `small`'s floor and keeps its
    ceiling, and its chain is complete, `small` and everything `small` IS-A. `subtypes` is the inverse, so `api`
    lists both.
    """
  valid: {
    resolved: """
      !schema {
        api => !meta.namespace { chain: { subtypes: [small smaller] }  key_type: meta.identifier  value_type: text }
        small => !meta.namespace {
          chain: { supertypes: [api]  subtypes: [smaller] }
          key_type: meta.identifier  value_type: text  max_items: 3
        }
        smaller => !meta.namespace {
          chain: { supertypes: [api small] }
          key_type: meta.identifier  value_type: text  min_items: 1  max_items: 3
        }
      }
      """
  }
}
