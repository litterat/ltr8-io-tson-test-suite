!!id:"https://tson.io/test-suite/class2/schema/valid/a-qualified-application-head-closes-at-the-root-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §4.2, [TSON-SCHEMA] §5.3, [TSON-SCHEMA] §5.10, [TSON-SCHEMA] §8.2 (qualified names, proposed)"
  description: """
    An application's head and a reference's `of` are qualified names like any other: `geo.box<text>` substitutes into
    the open record `box` of `geo`, and `meta.ref<geo.base>` constructs `!meta.ref { of: geo.base }`. A closed
    application is minted at the root, as every synthetic is, whatever map its head is a member of; the substitution's
    `@meta.application` states the head by its path, and the construction carries none.
    """
  valid: {
    resolved: """
      !schema {
        geo => !meta.schema {
          box => !meta.record {
            parameters: [ !meta.param { name: T } ]
            fields: { item => !meta.record_field { type: T } }
          }

          base => !meta.record { fields: { id => !meta.record_field { type: text } } }
        }

        @meta.application:geo.box<text>
        boxed => !meta.record {
          fields: { item => !meta.record_field { type: text } }
        }

        held => !meta.record { fields: { b => !meta.record_field { type: record_item_int32_xxhash } } }

        bases => !meta.ref { of: geo.base }

        @meta.synthetic record_item_int32_xxhash => !meta.record { fields: { item => !meta.record_field { type: int32 } } }
      }
      """
  }
}
