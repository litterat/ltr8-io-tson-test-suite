!!id:"https://tson.io/test-suite/class2/schema/valid/the-kernels-record-form-states-discriminators-beside-abstract-expected.tn"
!!import:"https://tson.io/test-suite/schemas/schema-sidecar.tn"
{
  spec: "[TSON-SCHEMA] §5.2"
  description: """
    The kernel's form of a member-dispatched base states both facts the sugar `pet_type: text =?` lowers to:
    `discriminators` beside `extension: ABSTRACT`. Its members compose it and pin the selector to distinct values,
    so the family loads exactly as one whose base is written `abstract { pet_type: text =?  name: text }`.
    """
  valid: {
    resolved: """
      !schema {
        pet => !meta.record { chain: { subtypes: [cat dog] }  fields: {
          pet_type => !meta.record_field { type: text }
          name     => !meta.record_field { type: text }
        }  extension: ABSTRACT  discriminators: [pet_type] }

        cat => !meta.record { chain: { supertypes: [pet] }  fields: {
          pet_type => !meta.record_field { type: text  optional: true  role: FIXED  value: "cat" }
          name     => !meta.record_field { type: text }
        } }

        dog => !meta.record { chain: { supertypes: [pet] }  fields: {
          pet_type => !meta.record_field { type: text  optional: true  role: FIXED  value: "dog" }
          name     => !meta.record_field { type: text }
        } }
      }
      """
  }
}
