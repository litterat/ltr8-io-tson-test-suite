!!id:"https://tson.io/test-suite/class1/lexer/invalid/lone-low-surrogate-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/lexer-sidecar.tn"
{
  spec: "§7.2.2"
  description: "A surrogate code point is not a Unicode scalar value, so an escape naming one is a lexer error -- the same rule that refuses a high surrogate, neither half being well-formed on its own terms."
  error: { category: lexer }
}
