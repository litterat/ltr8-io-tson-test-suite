!!id:"https://tson.io/test-suite/class1/lexer/invalid/utf8-lone-continuation-byte-expected.tn"
!!import:"https://tson.io/test-suite/schemas/lexer-sidecar.tn"
{
  spec: "§7.1"
  description: "A continuation byte with no lead byte before it is not a UTF-8 sequence. A decoder that substitutes U+FFFD instead of failing accepts a document that cannot be decoded, which §7.1 forbids: a byte sequence invalid in the document's encoding is a lexer error (§8.1)"
  encoding: invalid-utf8
  error: { category: lexer }
}
