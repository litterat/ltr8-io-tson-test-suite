!!id:"https://tson.io/test-suite/class1/lexer/invalid/bidi-isolate-outside-a-quoted-token-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/lexer-sidecar.tn"
{
  spec: "§7.1, §9.5"
  description: "U+2066 LEFT-TO-RIGHT ISOLATE, standing where a token boundary already exists and still refused: unlike U+200E and U+200F it is not Pattern_White_Space, so no context admits it outside a quoted token. §9.5 enumerates three ranges -- U+061C, U+202A-U+202E and U+2066-U+2069 -- and the isolates are the range no other vector reaches, so a profile built from a partial list is caught here."
  error: { category: lexer }
}
