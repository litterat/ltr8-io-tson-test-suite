!!id:"https://tson.io/test-suite/class1/reader/valid/base-types-at-record-field-values-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/reader-sidecar.tn"
{
  spec: "§4.5"
  description: "Base type resolution runs over an unquoted token in the fixed order null, boolean, number, string, so true is a boolean and Alice falls through to string."
  valid: {
    value: { record: { fields: [
      { name: "flag"  value: { atom: { boolean: true } } }
      { name: "name"  value: { atom: { string: "Alice" } } }
    ] } }
  }
}
