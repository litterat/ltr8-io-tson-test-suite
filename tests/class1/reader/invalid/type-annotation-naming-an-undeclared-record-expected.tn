!!id:"https://tson.io/test-suite/class1/reader/invalid/type-annotation-naming-an-undeclared-record-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/reader-sidecar.tn"
{
  spec: "§3.2, §5.1"
  description: "A schemaless document that names its own types binds the schema that declares them: with no `!!schema`, `!order` names no type and is a resolver error."
  error: { category: resolver }
}
