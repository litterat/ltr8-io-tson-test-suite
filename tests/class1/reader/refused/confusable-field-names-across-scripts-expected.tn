!!id:"https://tson.io/test-suite/class1/reader/refused/confusable-field-names-across-scripts-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/reader-sidecar.tn"
{
  spec: "§8.2"
  description: "Latin 'admin' and an 'admin' whose 'a' is Cyrillic U+0430 are two identifiers that NFC does not relate and a reader cannot tell apart. Mechanism 1 is skeleton distinctness over one named scope, and at this layer the scope is the field names of one record. The document is not invalid -- it is refused by this processor, under a policy that reads data the UCD does not freeze."
  refused: {
    mechanism: skeleton-distinctness
    unicode: "16.0"
  }
}
