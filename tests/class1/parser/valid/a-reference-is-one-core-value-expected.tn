    document: {
      id: _
      imports: []
      root: {
        annotations: []
        type-ref: _
        core: {
          record: {
            fields: [
              {
                name: t
                value: {
                  annotations: []
                  type-ref: _
                  core: {
                    reference: {
                      name: map
                      arguments: [
                        { token: { form: unquoted  text: text } }
                        { reference: { name: list  arguments: [ { token: { form: unquoted  text: int32 } } ] } }
                      ]
                    }
                  }
                }
              }
              {
                name: q
                value: {
                  annotations: []
                  type-ref: _
                  core: {
                    reference: {
                      name: geo.address
                      arguments: [
                        { token: { form: unquoted  text: T } }
                        { token: { form: unquoted  text: "201" } }
                        { token: { form: single-line  text: "a b" } }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
