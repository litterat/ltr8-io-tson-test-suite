                key: {
                  annotations: []
                  type-ref: _
                  core: {
                    token: { form: multi-line  text: "a" }
                  }
                }
                value: {
                  schema-ref: _
                  value: {
                    annotations: []
                    type-ref: _
                    core: {
                      token: { form: unquoted  text: "1" }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
