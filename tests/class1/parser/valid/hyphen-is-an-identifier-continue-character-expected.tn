!!id:"https://tson.io/test-suite/class1/parser/valid/hyphen-is-an-identifier-continue-character-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/parser-sidecar.tn"
{
  spec: "§7.7"
  description: "identifier-continue is XID_Continue plus '-', so a hyphen is a name character everywhere but the first position -- in an annotation name and a type-ref name alike. The trailing hyphen is part of the claim: nothing says a name may not end with one."
  valid: {
    document: {
      id: _
      schema: _
      root: {
        annotations: [
          {
            name: "my-ann"
            value: {
              annotations: []
              type-ref: _
              core: {
                token: { form: unquoted  text: "1" }
              }
            }
          }
        ]
        type-ref: "my-type-"
        core: {
          token: { form: unquoted  text: "2" }
        }
      }
    }
  }
}
