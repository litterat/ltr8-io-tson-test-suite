!!id:"https://tson.io/test-suite/class1/vocabulary/invalid/bytes-missing-padding-rejected-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/vocabulary-sidecar.tn"
{
  spec: "§5.5"
  description: "A common implementation trap: some base64 decoders (e.g. java.util.Base64.getDecoder()) accept missing padding and would decode this identically to the correctly-padded TWE=. RFC 4648 §3.2 requires padding unless the referring spec states otherwise, and §5.5 does not, so the !bytes contract must reject it."
  type-ref: "bytes"
  error: { category: resolver }
}
