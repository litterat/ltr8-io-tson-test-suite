{
  spec: "§5.5"
  description: "One nanosecond past the ceiling. The token is a perfectly well-formed duration, so this is a validation error and not a shape one -- the same distinction an out-of-range int32 makes."
  type-ref: "duration"
  error: { category: validation }
}
