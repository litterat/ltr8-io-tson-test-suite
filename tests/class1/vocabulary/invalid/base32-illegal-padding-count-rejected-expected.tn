!!id:"https://tson.io/test-suite/class1/vocabulary/invalid/base32-illegal-padding-count-rejected-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/vocabulary-sidecar.tn"
{
  spec: "§5.3"
  description: "RFC 4648 §6's padding table only permits 0/1/3/4/6 trailing '=' characters in a length-8 block -- 2 (as here) is never legal, regardless of what it would arithmetically decode to"
  type-ref: "base32"
  error: { category: resolver }
}
