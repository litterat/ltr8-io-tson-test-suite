!!id:"https://tson.io/test-suite/class1/vocabulary/invalid/datetime-space-instead-of-t-rejected-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/vocabulary-sidecar.tn"
{
  spec: "§5.4"
  description: "date-time requires the 'T'/'t' separator specifically -- a space (sometimes accepted by other date-time formats/profiles) is not RFC 3339 date-time"
  type-ref: "datetime"
  error: { category: resolver }
}
