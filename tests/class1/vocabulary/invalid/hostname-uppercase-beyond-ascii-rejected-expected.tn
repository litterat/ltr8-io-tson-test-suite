{
  spec: "§5.5"
  description: """
    IDNA2008 has no uppercase U-label and maps nothing, so uppercase beyond ASCII is refused
    rather than folded; bücher.example is the name
    """
  type-ref: "hostname"
  error: { category: resolver }
}
