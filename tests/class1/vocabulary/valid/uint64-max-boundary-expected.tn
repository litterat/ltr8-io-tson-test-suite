{
  spec: "§5.6"
  description: "18446744073709551615 (2^64-1) is the inclusive upper bound of the unsigned 64-bit range -- exceeds every signed 64-bit host type, so implementations binding to a fixed-width signed primitive need a wider representation here"
  type-ref: "uint64"
  valid: {
    value: { decimal: "18446744073709551615" }
  }
