!!id:"https://tson.io/test-suite/class1/vocabulary/valid/rational-negative-and-unreduced-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/vocabulary-sidecar.tn"
{
  spec: "§7.6"
  description: "meta.tn: rational tokens are not normalized (-2/4 round-trips as -2/4, not -1/2), but equality operates on the value -- asserting value: \"-1/2\" here (not \"-2/4\") checks that a conforming implementation compares -2/4 and -1/2 as equal, not that it silently reduces the written form"
  type-ref: "rational"
  valid: {
    value: { rational: "-1/2" }
  }
}
