!!id:"https://tson.io/test-suite/class1/vocabulary/valid/datetime-lowercase-t-and-z-expected.tn"
!!schema:"https://tson.io/test-suite/schemas/vocabulary-sidecar.tn"
{
  spec: "§5.4"
  description: "RFC 3339 explicitly allows lowercase 't'/'z' as alternatives to 'T'/'Z' -- value is given in canonical uppercase form since it represents the resulting value, not an echo of the input's exact casing"
  type-ref: "datetime"
  valid: {
    value: { text: "2025-03-13T10:15:30Z" }
  }
}
