{
  spec: "§5.5"
  description: "A clock duration. The value is a signed number of seconds, so PT1H30M is 5400 -- stated as the value rather than a spelling, PT90M and P0DT5400S being the same duration."
  type-ref: "duration"
  valid: {
    value: {
      decimal: "5400"
    }
  }
}
