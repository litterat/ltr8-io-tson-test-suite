!!id:"https://tson.io/test-suite/schemas/fixtures/meta-api.tn"
!!meta:"https://tson.io/2026/38/m/meta-kernel.tn"
!!import:"https://tson.io/2026/38/m/meta.tn"
@doc:"""
  A meta layer declaring two namespace types whose values stand as entries of a schema it governs. `api` maps
  identifiers to `method` records, so `myapi => !api { get_orders => { ... } }` is an entry whose value is a map
  of methods, and `router` maps identifiers to `route` records, each naming the method it serves at a slot typed
  `ref<method>`, reached through such an entry by a qualified name (`handler: myapi.get_orders`). A method's
  request, error and reply records are slots typed `kind<record>` and its response any type, `type_kind`. An entry
  built with either namespace type is a value, not a type; a processor that binds binds each value of the map to
  a host class of its own: the records `method` and `route`.
  """
{
  status_name => identifier
  method      => { request?: kind<record>  response?: type_kind  errors?: [kind<record>]  replies?: {status_name => kind<record>} }
  api         => namespace & { key_type: = identifier  value_type: = method }
  http_verb   => !enum [GET POST]
  route       => { verb: http_verb  path: text  handler: ref<method> }
  router      => namespace & { key_type: = identifier  value_type: = route }
}
