!!id:"https://tson.io/test-suite/schemas/fixtures/link-http.tn"
!!import:"https://tson.io/2026/39/m/core.tn"
@doc:"""
  An HTTP vocabulary written as an ordinary schema, standing in for the http project's http.tn: no meta layer, so a
  schema importing it declares its own endpoint shapes beside its operations. An `operation` is a record whose
  `request` names a record type (`meta.ref<record>`) and whose responses each name a body type (`meta.type_ref`); a `method`
  holds its request, response, error and reply types by name the same way, `api` is a namespace type mapping
  identifiers to methods, and a `binding` names the method it serves at a slot typed `meta.ref<method>`. A subject holds
  values of the records `operation`, `response`, `method` and `binding`.
  """
!schema {
  http_verb     => !enum [GET POST PUT DELETE]
  path_template => text
  status_name   => meta.identifier
  response      => { status: int32  body?: meta.type_ref }
  operation     => { method: http_verb  path: path_template  request?: meta.ref<meta.record>  responses: [response] }
  method        => { request?: meta.ref<meta.record>  response?: meta.type_ref  errors?: [meta.ref<meta.record>]  replies?: {status_name => meta.ref<meta.record>} }
  api           => !meta.namespace { key_type: meta.identifier  value_type: method }
  binding       => { method: meta.ref<method>  verb: http_verb  route: path_template }
}
