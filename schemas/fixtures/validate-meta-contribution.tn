!!id:"https://tson.io/test-suite/schemas/fixtures/validate-meta-contribution.tn"
!!import:"https://tson.io/2026/40/m/core.tn"
@doc:"""
  A schema contributing an incomplete entry to the kernel's open namespace `meta`: `meta.code_list` is an array
  left open with `max_items` written as 4, and `codes` is its completion, naming it by its path.
  """
!schema {
  meta => !schema {
    code_list => !meta.array ^ { max_items: 4 }
  }
  codes  => !meta.code_list { element_type: text }
  tagged => { c: codes }
}
