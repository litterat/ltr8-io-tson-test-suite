!!id:"https://tson.io/test-suite/schemas/fixtures/link-label-list.tn"
!!import:"https://tson.io/2026/40/m/meta.tn"
@doc:"""
  Writes `[text]` and imports only the kernel, as link-tag-list.tn does: each holds the construction in
  place at its own field, neither importing the other, and each resolves on its own.
  """
!schema {
  label_list => {
    labels: [text]
  }
}
