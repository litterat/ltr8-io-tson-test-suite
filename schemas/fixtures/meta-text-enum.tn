!!id:"https://tson.io/test-suite/schemas/fixtures/meta-text-enum.tn"
!!import:"https://tson.io/2026/40/m/meta.tn"
@doc:"""
  A schema declaring an enum left open, whose completions' members may contain a space. `text_identifier` is a
  second identifier family, and `text_enum` writes it as `name_type`, a slot the kernel types `meta.identifier_ref`:
  the names of the types built with `identifier_type`. `text_identifier` is one, in this schema's closure, so the
  field is a member and the schema loads; `members` is left absent ([TSON-SCHEMA] §5.5).
  """
!schema {
  text_identifier => !unicode.identifier_type { continue_add: " " }
  text_enum       => !meta.enum_type ^ { name_type: text_identifier }
}
