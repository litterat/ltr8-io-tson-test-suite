!!id:"https://tson.io/test-suite/schemas/fixtures/validate-namespace-bounds.tn"
!!import:"https://tson.io/2026/40/m/meta.tn"
!!import:"https://tson.io/2026/40/m/core.tn"
@doc:"""
  A namespace type with size bounds. `meta.namespace` refines `meta.map`, so `ordered` and `min_items`/
  `max_items` are a map's facets and bound a value as a map's do: `small` holds one or two header names.
  """
!schema {
  header_name => !unicode.identifier_type { continue_add: "-" }
  small       => !meta.namespace { key_type: header_name  value_type: text  min_items: 1  max_items: 2 }
  request     => { headers: small }
}
