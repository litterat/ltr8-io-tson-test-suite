!!id:"https://tson.io/test-suite/schemas/lexer-sidecar.tn"
!!meta:"https://tson.io/2026/34/m/meta.tn"
!!import:"https://tson.io/2026/34/m/core.tn"
!!import:"https://tson.io/test-suite/schemas/sidecar-common.tn"
@doc:"""
  Formal shape of a lexer-layer sidecar (tests/class1/lexer/**/*-expected.tn) -- see README.md's own
  "Valid lexer-layer vectors" section for the worked example this schema formalizes, and RUNNER.md
  for what a runner must do with one.
  """
{
  @doc:"The nine token kinds, using the spec's own token-stream vocabulary (§7.3), not any implementation's internal type names."
  lexer_token_kind => !enum [
    single-line-token
    multi-line-token
    unquoted-token
    absent-token
    structural-delimiter
    map-arrow-token
    directive-token
    range-token
    special-token
  ]

  @doc:"One token of the expected stream. `text` is the token's decoded text, EOF excluded from the stream entirely."
  lexer_token => {
    kind: lexer_token_kind
    text: text
  }

  @doc:"The payload of a `valid` outcome: the exact token stream, in order."
  lexer_valid => {
    tokens: [lexer_token]
  }

  @doc:"""
    Exactly one of `valid` or `error` is present -- a REQUIRED field group (§5.11), which is what
    makes the outcome and its payload inseparable: `valid` cannot omit its tokens, and `error`
    cannot carry them. The member label is the outcome; there is no separate `outcome` field.
    """
  lexer_sidecar => sidecar_common & {
    ( valid: lexer_valid | error: vector_error )
  }
}
